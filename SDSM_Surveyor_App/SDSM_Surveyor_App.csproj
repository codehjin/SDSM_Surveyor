<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SDSM_Surveyor_App</RootNamespace>
    <AssemblyName>SDSM_Surveyor_App</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Scrutor" Version="6.1.0" />
    <PackageReference Include="Telerik.UI.for.Wpf.AllControls.Xaml" Version="2026.2.520" />
  </ItemGroup>

  <ItemGroup>
    <!-- 관리자 앱과 공유하는 POCO 모델 (Fish/ImportFishSpecies/FishSpeciesList 등) -->
    <ProjectReference Include="..\..\SDSM\SDSM_Models\SDSM_Models.csproj" />
    <!-- 관리자와 공유하는 생태 계산(FAI·BMI·다양도지수·수질등급·HRI) -->
    <ProjectReference Include="..\..\SDSM\SDSM_Core\SDSM_Core.csproj" />
  </ItemGroup>

  <!-- 관리자 저장소(SDSM)를 같은 상위 폴더에 나란히 clone해야 빌드된다(05_REFACTORING §2-0).
       경로가 없을 때 알 수 없는 오류 수십 개 대신 이유를 알려 준다. -->
  <Target Name="CheckSiblingRepo" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\..\SDSM\SDSM_Models\SDSM_Models.csproj')"
           Text="관리자 저장소(SDSM)를 찾지 못했습니다. SDSM 과 SDSM_Surveyor 를 같은 상위 폴더에 나란히 clone하세요. 자세한 내용은 README.md 참조." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\..\SDSM\SDSM_Core\SDSM_Core.csproj')"
           Text="SDSM_Core 를 찾지 못했습니다. 관리자 저장소(SDSM)를 최신으로 pull 하세요. 자세한 내용은 README.md 참조." />
  </Target>

  <ItemGroup>
    <!-- 기준자료(관리자 DB에서 내보낸 종별 범위) 번들 -->
    <Content Include="reference.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 종목록 카탈로그(관리자 마스터 내보내기). AppData\SDSM_Surveyor\species.json으로 교체 가능 -->
    <Content Include="species.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 조사지점 마스터(제출 엑셀 조사지점 시트에서 생성). AppData\SDSM_Surveyor\sites.json으로 교체 가능 -->
    <Content Include="sites.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
