<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      design.md §3 컬러 토큰.
      ※ 삼성 브랜드 자산(로고·브랜드 남색)은 라이선스 대상이므로 사용하지 않는다.
        아래 강조색은 제품 UI 계열의 기능색이며 브랜드 마크 색이 아니다.
      ※ XAML에서는 반드시 이 키만 참조(리터럴 금지).
    -->

    <!--=========== 강조색 (앱 고유) ===========-->
    <Color x:Key="AppAccentColor">#FF0381FE</Color>
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}"/>

    <!-- 밝은 배경 위 텍스트/아이콘 대비 확보용 -->
    <Color x:Key="AppAccentStrongColor">#FF0072DE</Color>
    <SolidColorBrush x:Key="AppAccentStrongBrush" Color="{StaticResource AppAccentStrongColor}"/>

    <!-- 다크 모드 강조 -->
    <Color x:Key="AppAccentDarkColor">#FF3E91FF</Color>
    <SolidColorBrush x:Key="AppAccentDarkBrush" Color="{StaticResource AppAccentDarkColor}"/>

    <!--=========== 셸(상단바/사이드바) — 관리자 계승 ===========-->
    <Color x:Key="ShellPrimaryColor">#FF1E232E</Color>
    <SolidColorBrush x:Key="ShellPrimaryBrush" Color="{StaticResource ShellPrimaryColor}"/>

    <Color x:Key="ShellMouseOverColor">#AA293140</Color>
    <SolidColorBrush x:Key="ShellMouseOverBrush" Color="{StaticResource ShellMouseOverColor}"/>

    <Color x:Key="ShellSelectedColor">#FF353E52</Color>
    <SolidColorBrush x:Key="ShellSelectedBrush" Color="{StaticResource ShellSelectedColor}"/>

    <!-- 네이비 위 보조 텍스트 -->
    <Color x:Key="ShellForegroundColor">#FF869DCF</Color>
    <SolidColorBrush x:Key="ShellForegroundBrush" Color="{StaticResource ShellForegroundColor}"/>

    <!-- 네이비 위 제목 텍스트 -->
    <Color x:Key="ShellTitleForegroundColor">#FFF2F4F8</Color>
    <SolidColorBrush x:Key="ShellTitleForegroundBrush" Color="{StaticResource ShellTitleForegroundColor}"/>

    <!--=========== 분류군 식별색 — 관리자와 동일 ===========-->
    <Color x:Key="FishColor">#FF00B8D4</Color>
    <SolidColorBrush x:Key="FishBrush" Color="{StaticResource FishColor}"/>

    <Color x:Key="BenthosColor">#FF651FFF</Color>
    <SolidColorBrush x:Key="BenthosBrush" Color="{StaticResource BenthosColor}"/>

    <Color x:Key="BirdColor">#FF9E9D24</Color>
    <SolidColorBrush x:Key="BirdBrush" Color="{StaticResource BirdColor}"/>

    <Color x:Key="MammalColor">#FFFE9900</Color>
    <SolidColorBrush x:Key="MammalBrush" Color="{StaticResource MammalColor}"/>

    <Color x:Key="AmphibianReptileColor">#FFCC33FF</Color>
    <SolidColorBrush x:Key="AmphibianReptileBrush" Color="{StaticResource AmphibianReptileColor}"/>

    <Color x:Key="HabitatWaterEdgeColor">#FF37474F</Color>
    <SolidColorBrush x:Key="HabitatWaterEdgeBrush" Color="{StaticResource HabitatWaterEdgeColor}"/>

    <Color x:Key="WaterQualityColor">#FF2979FF</Color>
    <SolidColorBrush x:Key="WaterQualityBrush" Color="{StaticResource WaterQualityColor}"/>

    <!--=========== 차트·통계 — 관리자 계승 ===========-->
    <Color x:Key="MaxColor">#FFF25022</Color>
    <SolidColorBrush x:Key="MaxBrush" Color="{StaticResource MaxColor}"/>

    <Color x:Key="AvgColor">#FF8EC441</Color>
    <SolidColorBrush x:Key="AvgBrush" Color="{StaticResource AvgColor}"/>

    <Color x:Key="MinColor">#FF5B9BD5</Color>
    <SolidColorBrush x:Key="MinBrush" Color="{StaticResource MinColor}"/>

    <!--=========== 등급 뱃지 (06_DESIGN_REBUILD §5-4) ===========-->
    <!-- 등급은 항상 글자(A~E)와 함께 나온다. 색만으로 구분하지 않는다(design.md §10). -->
    <Color x:Key="GradeAColor">#FF2E7D32</Color>
    <SolidColorBrush x:Key="GradeABrush" Color="{StaticResource GradeAColor}"/>

    <Color x:Key="GradeBColor">#FF0381FE</Color>
    <SolidColorBrush x:Key="GradeBBrush" Color="{StaticResource GradeBColor}"/>

    <Color x:Key="GradeCColor">#FFF9A825</Color>
    <SolidColorBrush x:Key="GradeCBrush" Color="{StaticResource GradeCColor}"/>

    <Color x:Key="GradeDColor">#FFEF6C00</Color>
    <SolidColorBrush x:Key="GradeDBrush" Color="{StaticResource GradeDColor}"/>

    <Color x:Key="GradeEColor">#FFC62828</Color>
    <SolidColorBrush x:Key="GradeEBrush" Color="{StaticResource GradeEColor}"/>

    <!-- 미평가(`-`) — 0점·E등급과 반드시 달라 보여야 한다(_excel_formula_audit §5-5) -->
    <Color x:Key="GradeNoneColor">#FF9AA0A8</Color>
    <SolidColorBrush x:Key="GradeNoneBrush" Color="{StaticResource GradeNoneColor}"/>

    <!--=========== 표 · 행 ===========-->
    <Color x:Key="RowAltColor">#FFFAFBFC</Color>
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}"/>

    <!-- 2단 행의 아랫줄(관찰형 흔적·분류 묶음). 윗줄과 같은 행임을 시각적으로 묶는다. -->
    <Color x:Key="Row2LineColor">#FFF5F6F8</Color>
    <SolidColorBrush x:Key="Row2LineBrush" Color="{StaticResource Row2LineColor}"/>

    <Color x:Key="GridHeaderColor">#FFF1F2F4</Color>
    <SolidColorBrush x:Key="GridHeaderBrush" Color="{StaticResource GridHeaderColor}"/>

    <!--=========== 읽기전용 · 비활성 (§5-6 — 둘을 구분한다) ===========-->
    <!-- 읽기전용 : 값은 유효하다. 편집만 안 된다. -->
    <Color x:Key="ReadOnlyBackColor">#FFF7F8FA</Color>
    <SolidColorBrush x:Key="ReadOnlyBackBrush" Color="{StaticResource ReadOnlyBackColor}"/>

    <!-- 비활성 : 아직 쓸 수 없다(예: 대분류 미선택 시 지점 드롭다운 §3-8). -->
    <Color x:Key="DisabledBackColor">#FFF1F2F4</Color>
    <SolidColorBrush x:Key="DisabledBackBrush" Color="{StaticResource DisabledBackColor}"/>

    <Color x:Key="DisabledForeColor">#FF9AA0A8</Color>
    <SolidColorBrush x:Key="DisabledForeBrush" Color="{StaticResource DisabledForeColor}"/>

</ResourceDictionary>
