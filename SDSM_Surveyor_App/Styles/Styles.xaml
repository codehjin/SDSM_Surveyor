<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:SDSM_Surveyor_App.Converters"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">

    <!--=========== 컨버터 ===========-->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- design.md §2·§4 : 폰트 · 치수 · 타이포 · 레이아웃 토큰
         ※ Colors.xaml 이후에 병합되어야 함(셸 브러시 참조) -->

    <!--=========== 폰트 ===========-->
    <!-- SamsungOne은 라이선스 대상이라 사용하지 않음. 시스템 한글 고딕 사용. -->
    <FontFamily x:Key="DefaultFontFamily">Malgun Gothic</FontFamily>
    <sys:Double x:Key="DefaultFontSize">14.5</sys:Double>
    <sys:Double x:Key="PageTitleFontSize">26</sys:Double>
    <sys:Double x:Key="SectionTitleFontSize">19</sys:Double>
    <sys:Double x:Key="FormLabelFontSize">15</sys:Double>
    <sys:Double x:Key="CaptionFontSize">11.5</sys:Double>
    <sys:Double x:Key="ValueFontSize">30</sys:Double>
    <sys:Double x:Key="GradeFontSize">24</sys:Double>

    <!--=========== 치수 ===========-->
    <sys:Double x:Key="DefaultHeight">40</sys:Double>
    <sys:Double x:Key="TitleBarHeight">50</sys:Double>
    <sys:Double x:Key="ContentXSmallMaxWidth">1240</sys:Double>
    <sys:Double x:Key="FormControlSmallWidth">120</sys:Double>
    <sys:Double x:Key="FormControlMiddleWidth">149.5</sys:Double>
    <sys:Double x:Key="FormControlWidth">240</sys:Double>

    <!--=========== 타이포그래피 ===========-->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource SectionTitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 카드 내부 소제목 -->
    <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0 0 0 10"/>
    </Style>

    <!-- 폼 라벨 -->
    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FormLabelFontSize}"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
        <Setter Property="Margin" Value="0 0 0 2"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 보조 설명 -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 핵심 수치(지수·점수) -->
    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ValueFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}"/>
    </Style>

    <!-- 등급 -->
    <Style x:Key="GradeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource GradeFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
    </Style>

    <!--=========== 레이아웃 ===========-->
    <!-- 섹션 카드 -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=SecondaryBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- 하단 상태바 -->
    <Style x:Key="StatusBarBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="10 6"/>
    </Style>

    <!--=========== 셸 캡션 버튼 (딥네이비 상단바용) ===========-->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource ShellTitleForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ShellSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}"/>

    <!-- 캡션의 텍스트형 버튼(동기화 등) : 아이콘+글자, 네이비 셸용 -->
    <Style x:Key="CaptionTextButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Padding" Value="14 0"/>
        <Setter Property="Foreground" Value="{StaticResource ShellForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ShellSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource ShellTitleForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--=========== 관리자식 폼 필드 (라벨 좌 · 입력 우) ===========-->
    <!-- 관리자 '신규' 다이얼로그와 동일한 구성: 회색 라벨 칸 + 흰 입력 칸 -->
    <SolidColorBrush x:Key="FieldLabelBackgroundBrush" Color="#FFF1F2F4"/>
    <SolidColorBrush x:Key="FieldLabelForegroundBrush" Color="#FF3C4351"/>
    <SolidColorBrush x:Key="GroupLabelBackgroundBrush" Color="#FFE9EBEE"/>
    <SolidColorBrush x:Key="FormLineBrush" Color="#FFDCDFE4"/>
    <SolidColorBrush x:Key="RequiredMarkBrush" Color="#FFE02B2B"/>

    <!-- 좌측 라벨 칸 -->
    <Style x:Key="FieldLabelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FieldLabelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FormLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="12 0"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0 0 8 8"/>
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource FieldLabelForegroundBrush}"/>
    </Style>

    <!-- 세로 그룹 라벨 (조사개황 · 채집방법 …) -->
    <Style x:Key="GroupLabelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GroupLabelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FormLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Margin" Value="0 0 8 8"/>
        <Setter Property="Width" Value="62"/>
    </Style>

    <Style x:Key="GroupLabelTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource FieldLabelForegroundBrush}"/>
    </Style>

    <!--=========== 분류군 탭 (관리자 통계 화면과 동일 형식) ===========-->
    <!-- Tag에 분류군 브러시를 지정하면 표시등 색으로 사용됨 -->
    <Style x:Key="TaxonTabStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="46"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Foreground" Value="#FF5B6472"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Margin="0 0 3 0"
                            Background="#FFE9EBEE"
                            BorderBrush="{StaticResource FormLineBrush}"
                            BorderThickness="1 1 1 1"
                            CornerRadius="4 4 0 0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="dot" Width="9" Height="9" CornerRadius="4.5"
                                    Margin="0 0 9 0" VerticalAlignment="Center" Opacity="0.4"
                                    Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFF3F4F6"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFFFFFFF"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1 3 1 0"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AppAccentBrush}"/>
                            <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="#FF1E232E"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ※ StyleManager 테마 사용 중이므로 RadTabItem에 Style을 통째로 지정하지 않는다
         (테마 템플릿이 벗겨짐). 분류군 탭은 위 RadioButton 기반 세그먼트 탭을 사용한다. -->

</ResourceDictionary>
