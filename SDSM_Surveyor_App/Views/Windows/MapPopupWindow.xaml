<Window x:Class="SDSM_Surveyor_App.Views.Windows.MapPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
        xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
        mc:Ignorable="d"
        Title="지도" Width="960" Height="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource DefaultFontSize}"
        Background="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"
        d:DataContext="{d:DesignInstance vm:MapPopupViewModel}">

    <!-- 지점 지도 (발주처 요구 2026-09-08 · 부사장 확정 2026-09-09)
         · 기본은 그 권역의 최신 지도 한 장
         · 마커는 **지금 입력된 좌표 하나만**. 지도에 인쇄된 지점 표시는 배경 그대로 둔다
         · 지도는 참고 자료다 — 조사자가 자유롭게 추가·교체·삭제할 수 있다 -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 제목 · 지도 선택 -->
            <RowDefinition Height="Auto"/>   <!-- 참고용 띠 -->
            <RowDefinition Height="Auto"/>   <!-- 안내 -->
            <RowDefinition Height="*"/>      <!-- 지도 -->
            <RowDefinition Height="Auto"/>   <!-- 액션 -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <icon:PackIconMaterial Kind="MapMarkerOutline" Width="20" Height="20" VerticalAlignment="Center"
                                       Foreground="{StaticResource AppAccentBrush}"/>
                <TextBlock Text="{Binding HeaderText}" Margin="8 0 0 0" VerticalAlignment="Center"
                           Style="{StaticResource SectionTitleTextStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="지도" VerticalAlignment="Center" Margin="0 0 8 0"
                           Style="{StaticResource CaptionTextStyle}"/>
                <telerik:RadComboBox x:Name="MapCombo" Width="300"
                                     BorderBrush="{StaticResource InputBorderBrush}"
                                     BorderThickness="{StaticResource BorderThin}"
                                     Background="{StaticResource InputBackBrush}"
                                     Height="{StaticResource InputHeight}"
                                     ItemsSource="{Binding Maps}"
                                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                                     DisplayMemberPath="Display"
                                     EmptyText="등록된 지도 없음"
                                     AutomationProperties.Name="지도 고르기"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PinnedNoticeBorderStyle}" Margin="0 0 0 8"
                Visibility="{Binding IsReference, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ReferenceText}" Style="{StaticResource PinnedNoticeTextStyle}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource WarnBoxBorderStyle}" Margin="0 0 0 8"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
            <!-- ⚠ 원인 문구는 경로·예외까지 여러 줄로 온다. Wrap 을 켜고 아이콘을 위로 붙인다. -->
            <StackPanel Orientation="Horizontal">
                <icon:PackIconMaterial Kind="AlertCircleOutline" Width="14" Height="14"
                                       VerticalAlignment="Top" Margin="0 2 0 0"
                                       Foreground="{StaticResource DangerOnSurfaceBrush}"/>
                <TextBlock Text="{Binding NoticeText}" Margin="6 0 0 0"
                           TextWrapping="Wrap" MaxWidth="760"
                           Style="{StaticResource WarnBoxTextStyle}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource CornerRadiusMd}" ClipToBounds="True">
            <ctrl:PanZoomImage x:Name="Viewer"/>
        </Border>

        <Grid Grid.Row="4" Margin="0 12 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource TertiaryForegroundBrush}"
                       Text="휠로 확대·축소, 끌어서 이동합니다. 지도는 참고 자료입니다."/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <telerik:RadButton Content="전체 보기" Padding="12 4" Margin="0 0 8 0" Click="Fit_Click"/>
                <telerik:RadButton Content="브라우저로 열기" Padding="12 4" Margin="0 0 8 0"
                                   Command="{Binding Meta.OpenMapCommand}"
                                   IsEnabled="{Binding Meta.HasMap}"
                                   ToolTipService.ToolTip="기본 브라우저 지도에서 이 좌표를 엽니다"/>
                <telerik:RadButton Content="지도 관리" Padding="12 4" Margin="0 0 8 0" Click="Manage_Click"/>
                <telerik:RadButton Content="닫기" Padding="16 4" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
