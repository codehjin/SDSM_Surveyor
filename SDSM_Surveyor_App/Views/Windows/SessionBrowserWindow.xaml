<Window x:Class="SDSM_Surveyor_App.Views.Windows.SessionBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
        mc:Ignorable="d"
        Title="자료함" Width="1080" Height="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource DefaultFontSize}"
        Background="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"
        d:DataContext="{d:DesignInstance vm:SessionBrowserViewModel}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 제목 -->
            <RowDefinition Height="Auto"/>   <!-- 검색 -->
            <RowDefinition Height="*"/>      <!-- 목록 -->
            <RowDefinition Height="Auto"/>   <!-- 복제 -->
            <RowDefinition Height="Auto"/>   <!-- 상태·액션 -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 12">
            <icon:PackIconMaterial Kind="FolderMultipleOutline" Width="20" Height="20" VerticalAlignment="Center"
                                   Foreground="{StaticResource AppAccentBrush}"/>
            <TextBlock Text="자료함 (조사 세션)" Margin="10 0 0 0" VerticalAlignment="Center"
                       Style="{StaticResource SectionTitleTextStyle}"/>
            <TextBlock Text="대분류 · 연도차수 · 지점 하나가 세션 한 건입니다. 행을 두 번 누르면 7개 탭에 그대로 복원됩니다."
                       Margin="14 0 0 0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <telerik:RadWatermarkTextBox WatermarkContent="지점·하천·연도차수·사업장 검색"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
            <telerik:RadButton Grid.Column="2" Command="{Binding RefreshCommand}" Padding="12 4">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="Reload" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="새로고침" Margin="6 0 0 0"/>
                </StackPanel>
            </telerik:RadButton>
        </Grid>

        <telerik:RadGridView Grid.Row="2" x:Name="SessionGrid"
                             ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             AutoGenerateColumns="False" IsReadOnly="True"
                             ShowGroupPanel="False" CanUserFreezeColumns="False"
                             RowIndicatorVisibility="Collapsed"
                             MouseDoubleClick="Grid_MouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="대분류"   DataMemberBinding="{Binding Project}"   Width="90"/>
                <telerik:GridViewDataColumn Header="사업장"   DataMemberBinding="{Binding Workplace}" Width="80"/>
                <telerik:GridViewDataColumn Header="하천"     DataMemberBinding="{Binding River}"     Width="100"/>
                <telerik:GridViewDataColumn Header="지점"     DataMemberBinding="{Binding Site}"      Width="130"/>
                <telerik:GridViewDataColumn Header="연도차수" DataMemberBinding="{Binding YearChsu}"  Width="120"/>
                <telerik:GridViewDataColumn Header="최종수정" DataMemberBinding="{Binding UpdatedText}" Width="140"/>
                <telerik:GridViewDataColumn Header="입력 분류군" DataMemberBinding="{Binding TaxaText}" Width="*"/>
                <telerik:GridViewDataColumn Header="경고"     DataMemberBinding="{Binding Warnings}"  Width="60"
                                            TextAlignment="Center"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <!-- 복제 2종 : 반복입력을 줄이는 핵심 기능 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0 12 0 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="지점 간 값 복사" Style="{StaticResource SubHeaderTextStyle}"/>
                    <TextBlock Text="현재 화면의 조사개황(연도차수·조사자·날씨·조사기관)은 두고 지점만 바꿉니다. 종 목록은 비웁니다."
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0 2 0 6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <telerik:RadComboBox ItemsSource="{Binding SiteOptions}"
                                             SelectedItem="{Binding CopyTargetSite, Mode=TwoWay}"
                                             DisplayMemberPath="DisplayLong"
                                             IsEditable="True" IsFilteringEnabled="True"
                                             EmptyText="옮겨 갈 지점 선택"/>
                        <telerik:RadButton Grid.Column="1" Margin="8 0 0 0" Padding="12 4"
                                           Content="지점 복사" Command="{Binding CopyToSiteCommand}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="이전 차수 복사 후 수정" Style="{StaticResource SubHeaderTextStyle}"/>
                    <TextBlock Text="선택한 세션을 종 목록까지 통째로 복제하고 연도차수만 바꿉니다. 개체수만 갱신하면 됩니다."
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0 2 0 6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <telerik:RadWatermarkTextBox WatermarkContent="새 연도차수 (예: 2026반기2차)"
                                                     Text="{Binding NewYearChsu, UpdateSourceTrigger=PropertyChanged}"/>
                        <telerik:RadButton Grid.Column="1" Margin="8 0 0 0" Padding="12 4"
                                           Content="차수 복제" Command="{Binding CopyFromPreviousCommand}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0 14 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource AppAccentStrongBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <telerik:RadButton Command="{Binding SaveCurrentCommand}" Margin="0 0 8 0" Padding="14 5">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="현재 화면 저장" Margin="6 0 0 0"/>
                    </StackPanel>
                </telerik:RadButton>
                <telerik:RadButton Command="{Binding DeleteSessionCommand}" Margin="0 0 8 0" Padding="14 5">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="TrashCanOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="삭제" Margin="6 0 0 0"/>
                    </StackPanel>
                </telerik:RadButton>
                <telerik:RadButton Command="{Binding LoadSessionCommand}" Margin="0 0 8 0" Padding="14 5">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="불러오기" Margin="6 0 0 0"/>
                    </StackPanel>
                </telerik:RadButton>
                <telerik:RadButton Content="닫기" Padding="18 5" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
