<Window x:Class="SDSM_Surveyor_App.Views.Windows.SpeciesCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
        mc:Ignorable="d"
        Title="종목록" Width="1080" Height="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource DefaultFontSize}"
        Background="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"
        d:DataContext="{d:DesignInstance vm:SpeciesCatalogViewModel}">

    <!-- 종목록 팝업 (발주처 요구 2026-09-08)
         ⚠ 담당 분류군 종목록만 보여 준다. 다른 분류군은 열지 않는다.
         ⚠ 열은 코드비하인드가 분류군에 맞춰 만든다 — 컬럼은 시각 트리 밖이라
            RelativeSource 바인딩으로 보이기/숨기기를 할 수 없다. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 제목 -->
            <RowDefinition Height="Auto"/>   <!-- 검색 -->
            <RowDefinition Height="*"/>      <!-- 목록 -->
            <RowDefinition Height="Auto"/>   <!-- 상태·액션 -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 12">
            <icon:PackIconMaterial Kind="FormatListBulleted" Width="20" Height="20" VerticalAlignment="Center"
                                   Foreground="{StaticResource AppAccentBrush}"/>
            <TextBlock Text="{Binding HeaderText}" Margin="8 0 0 0" VerticalAlignment="Center"
                       Style="{StaticResource SectionTitleTextStyle}"/>
            <TextBlock Text="행을 두 번 누르면 야장에 그 종이 들어갑니다. 개체수는 비워 둡니다."
                       Margin="12 0 0 0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- SearchBoxBorderStyle 이 Width 340 을 세터로 준다 — 열 폭을 거기 맞춘다. -->
            <Border Grid.Column="0" Style="{StaticResource SearchBoxBorderStyle}" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <icon:PackIconMaterial Grid.Column="0" Kind="Magnify"
                                           Width="{StaticResource SearchIconSize}"
                                           Height="{StaticResource SearchIconSize}"
                                           Margin="10 0 0 0" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentOnSurfaceBrush}"/>
                    <telerik:RadWatermarkTextBox Grid.Column="1" x:Name="SearchBox"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                                 WatermarkContent="국명 · 학명 · 초성 검색 (예: ㄲㅁㅈ)"
                                                 Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="종목록 검색"/>
                </Grid>
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="12 0 0 0"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource TertiaryForegroundBrush}"/>

            <telerik:RadButton Grid.Column="2" Command="{Binding ClearSearchCommand}" Padding="12 4">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="Reload" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="검색 지움" Margin="4 0 0 0"/>
                </StackPanel>
            </telerik:RadButton>
        </Grid>

        <telerik:RadGridView Grid.Row="2" x:Name="CatalogGrid"
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             AutoGenerateColumns="False" IsReadOnly="True"
                             ShowGroupPanel="False" CanUserFreezeColumns="False"
                             GridLinesVisibility="Horizontal"
                             RowIndicatorVisibility="Collapsed"
                             MouseDoubleClick="Grid_MouseDoubleClick"/>

        <Grid Grid.Row="3" Margin="0 12 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SaveHint" Grid.Column="0" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <telerik:RadButton Command="{Binding ExportExcelCommand}" Padding="12 4" Margin="0 0 8 0">
                    <StackPanel Orientation="Horizontal">
                        <icon:PackIconMaterial Kind="MicrosoftExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="엑셀로 저장" Margin="4 0 0 0"/>
                    </StackPanel>
                </telerik:RadButton>
                <telerik:RadButton Content="닫기" Padding="16 4" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
