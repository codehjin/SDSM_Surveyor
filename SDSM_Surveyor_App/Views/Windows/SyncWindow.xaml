<Window x:Class="SDSM_Surveyor_App.Views.Windows.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
        mc:Ignorable="d"
        Title="동기화" Width="620" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource DefaultFontSize}"
        Background="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"
        d:DataContext="{d:DesignInstance vm:SyncViewModel}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 14">
            <icon:PackIconMaterial Kind="CloudSyncOutline" Width="20" Height="20" VerticalAlignment="Center"
                                   Foreground="{StaticResource AppAccentBrush}"/>
            <TextBlock Text="동기화 (교환소 폴더)" Margin="10 0 0 0" VerticalAlignment="Center"
                       Style="{StaticResource SectionTitleTextStyle}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0 0 0 12"
                   Style="{StaticResource CaptionTextStyle}"
                   Text="관리자·조사자가 함께 접근하는 공유/클라우드 폴더를 지정하세요. 관리자가 올린 species.json·reference.json을 여기서 '가져오기'로 받아옵니다. (서버 없이 파일로 주고받는 비동기 동기화)"/>

        <!-- 교환소 폴더 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0 0 0 12">
            <StackPanel>
                <TextBlock Text="교환소 폴더" Style="{StaticResource FormLabelStyle}"/>
                <Grid Margin="0 2 0 0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <telerik:RadWatermarkTextBox WatermarkContent="예: D:\공유\SDSM_교환소 또는 클라우드 동기 폴더"
                                                 Text="{Binding ExchangeFolder, UpdateSourceTrigger=PropertyChanged}"/>
                    <telerik:RadButton Grid.Column="1" Margin="8 0 0 0" Padding="12 4" Click="Browse_Click">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="찾아보기" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 버전 비교 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="14">
            <StackPanel>
                <TextBlock Text="버전 비교" Style="{StaticResource SubHeaderTextStyle}"/>
                <TextBlock Text="{Binding SpeciesStatus}" Margin="0 2 0 6" TextWrapping="Wrap"
                           Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                <TextBlock Text="{Binding ReferenceStatus}" TextWrapping="Wrap"
                           Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                <TextBlock Text="{Binding Message}" Margin="0 12 0 0" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{StaticResource AppAccentStrongBrush}"/>
            </StackPanel>
        </Border>

        <!-- 하단 액션 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
            <telerik:RadButton Command="{Binding RefreshCommand}" Margin="0 0 8 0" Padding="14 5">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="Reload" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="새로고침" Margin="6 0 0 0"/>
                </StackPanel>
            </telerik:RadButton>
            <telerik:RadButton Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" Margin="0 0 8 0" Padding="14 5">
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconMaterial Kind="CloudDownloadOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="가져오기" Margin="6 0 0 0"/>
                </StackPanel>
            </telerik:RadButton>
            <telerik:RadButton Content="닫기" Padding="18 5" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
