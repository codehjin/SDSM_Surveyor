<Window x:Class="SDSM_Surveyor_App.Views.Windows.MainSurveyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
        xmlns:core="clr-namespace:SDSM_Surveyor_App.Behaviors"
        xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainSurveyWindowViewModel}"
        Title="{Binding WindowTitle}"
        MinWidth="1280" Width="1440"
        MinHeight="760" Height="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource DefaultFontSize}"
        Background="{StaticResource PageBackBrush}"
        x:Name="_this">

    <!-- 단일 분류군 모드 셸 (README §2 · 시안 3a)
         ⚠ 상단 분류군 탭 행(44px)은 표시하지 않는다. 재선택은 캡션 바 분류군 칩에서 한다.
         ⚠ 종전 '야외 모드' 버튼은 삭제했고 그 자리를 칩이 쓴다.
         ⚠ 7개 EntryControl 은 그대로 살아 있다 — 보이는 것만 하나로 좁힌다.
            (7개 EntryViewModel 싱글턴·세션 저장 단위는 건드리지 않는다.) -->

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" CaptionHeight="50" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource TitleBarRowHeight}"/>   <!-- 캡션 50 -->
                <RowDefinition Height="*"/>                                    <!-- 본문 -->
            </Grid.RowDefinitions>

            <!--═══ 캡션 바 (50px · 딥네이비 셸 · design.md §3.2) ═══════════════
                 ⚠ 삼성 로고·브랜드 남색·SamsungOne 은 쓰지 않는다(라이선스 원칙).
                    앱 마크는 강조색 사각형이고 앱 이름은 한글만 적는다(영문명 없음). -->
            <Border Grid.Row="0" Background="{StaticResource ShellPrimaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="20 0 0 0">

                        <!-- 앱 마크 : 로고가 아니라 강조색 사각형이다 -->
                        <Border Width="{StaticResource AppMarkSize}" Height="{StaticResource AppMarkSize}"
                                CornerRadius="{StaticResource AppMarkRadius}"
                                Background="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding WindowTitle}" Margin="14 0 0 0" VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ShellTitleForegroundBrush}"/>

                        <TextBlock Text="{Binding Version}" Margin="14 0 0 0" VerticalAlignment="Center"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   Foreground="{StaticResource ShellForegroundBrush}"/>

                        <Border Style="{StaticResource ShellVerticalDividerStyle}" Margin="14 0 0 0"/>

                        <!--── 분류군 칩 : 담당 분류군 표시 + 재선택 ──────────────
                             ⚠ 색점은 *OnShellBrush 를 쓴다 — 기본 7색은 딥네이비 위에서
                                1.36~3.95:1 로 무너진다(design.md §3.7). -->
                        <ToggleButton x:Name="TaxonChip" Margin="14 0 0 0"
                                      Style="{StaticResource TaxonChipToggleStyle}"
                                      IsChecked="{Binding IsTaxonPopupOpen, Mode=TwoWay}"
                                      WindowChrome.IsHitTestVisibleInChrome="True"
                                      AutomationProperties.Name="담당 분류군 변경"
                                      ToolTipService.ToolTip="담당 분류군을 바꿉니다. 입력 중인 자료는 유지됩니다.">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{StaticResource TaxonDotSize}" Height="{StaticResource TaxonDotSize}"
                                        CornerRadius="{StaticResource TaxonDotRadius}" VerticalAlignment="Center"
                                        Background="{Binding Taxon.DotOnShellBrushKey, Converter={StaticResource KeyToBrush}}"/>
                                <TextBlock Text="{Binding Taxon.Name}" Margin="8 0 0 0" VerticalAlignment="Center"
                                           FontSize="{StaticResource SummaryFontSize}" FontWeight="SemiBold"
                                           Foreground="{StaticResource ShellTitleForegroundBrush}"/>
                                <TextBlock Text="{Binding TaxonChipCaption}" Margin="8 0 0 0" VerticalAlignment="Center"
                                           FontSize="{StaticResource ChipCaptionFontSize}"
                                           Foreground="{StaticResource ShellForegroundBrush}"/>
                                <Path Style="{StaticResource ChevronPathStyle}"
                                      Stroke="{StaticResource ShellForegroundBrush}"/>
                            </StackPanel>
                        </ToggleButton>

                        <!--── 재선택 팝오버 (300px · README §2.2) ───────────────
                             분류군을 바꿔도 세션 자료는 유지된다 —
                             세션 하나가 7개 분류군을 함께 담는 기존 구조 그대로다. -->
                        <Popup IsOpen="{Binding IsTaxonPopupOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=TaxonChip}"
                               Placement="Bottom" VerticalOffset="6" HorizontalOffset="-8"
                               StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade" Focusable="True">
                            <Border Style="{StaticResource PopupCardBorderStyle}" Margin="12">
                                <StackPanel>
                                    <TextBlock Text="담당 분류군 변경 — 입력 중인 자료는 유지됩니다"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TertiaryForegroundBrush}"
                                               Margin="8 4 8 8"/>

                                    <ItemsControl ItemsSource="{Binding TaxonMenu}"
                                                  KeyboardNavigation.TabNavigation="Local">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.PickTaxonCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Name}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PopupItemButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" VerticalAlignment="Center"
                                                                Width="{StaticResource TaxonDotSize}"
                                                                Height="{StaticResource TaxonDotSize}"
                                                                CornerRadius="{StaticResource TaxonDotRadius}"
                                                                Background="{Binding DotBrushKey, Converter={StaticResource KeyToBrush}}"/>

                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10 0 0 0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentOnSurfaceBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- 미입력은 `·` — 0 을 적으면 '조사해서 0' 과 구분되지 않는다 -->
                                                        <TextBlock Grid.Column="2" Text="{Binding CountText}"
                                                                   FontSize="{StaticResource ChipCaptionFontSize}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                                    <Setter Property="Foreground"
                                                                            Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentOnSurfaceBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Style="{StaticResource HorizontalDividerStyle}" Margin="8 8 8 0"/>

                                    <CheckBox Margin="8 8 8 4" FontSize="{StaticResource ChipCaptionFontSize}"
                                              Content="다음 실행에도 이 분류군으로 시작"
                                              IsChecked="{Binding Taxon.RememberOnStartup, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- 세션 요약 -->
                        <TextBlock Text="{Binding SessionSummary}" Margin="14 0 0 0" VerticalAlignment="Center"
                                   FontSize="{StaticResource LinkFontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource ShellMutedForegroundBrush}"/>
                    </StackPanel>

                    <!-- 우측 : 자료함 · 동기화 · 사용설명서(v0.5.2) · 정보(v0.5.0) pill + 창 버튼 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 14 0">
                            <Button Click="Sessions_Click" Style="{StaticResource ShellPillButtonStyle}"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    AutomationProperties.Name="자료함">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="FolderMultipleOutline" Width="13" Height="13"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="자료함" Margin="6 0 0 0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="Sync_Click" Style="{StaticResource ShellPillButtonStyle}"
                                    Margin="8 0 0 0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    AutomationProperties.Name="동기화">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="CloudSyncOutline" Width="13" Height="13"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SyncPillText}" Margin="6 0 0 0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- §26-3 : 사용설명서 PDF(실행 폴더 manual\surveyor_manual.pdf) — 없으면 알림 띠로 알린다 -->
                            <Button Click="Manual_Click" Style="{StaticResource ShellPillButtonStyle}"
                                    Margin="8 0 0 0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    AutomationProperties.Name="사용설명서"
                                    ToolTipService.ToolTip="사용설명서(PDF)를 엽니다">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="BookOpenVariant" Width="13" Height="13"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="사용설명서" Margin="6 0 0 0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="Info_Click" Style="{StaticResource ShellPillButtonStyle}"
                                    Margin="8 0 0 0"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    AutomationProperties.Name="프로그램 정보"
                                    ToolTipService.ToolTip="판 · 적용 지침(원본 보기) · 종목록 판 · 개발 · 연락처">
                                <StackPanel Orientation="Horizontal">
                                    <icon:PackIconMaterial Kind="InformationOutline" Width="13" Height="13"
                                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="정보" Margin="6 0 0 0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Click="Minimize_Click" Style="{StaticResource CaptionButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="최소화">
                            <icon:PackIconCodicons Kind="ChromeMinimize" Width="12" Height="12"/>
                        </Button>
                        <Button Click="Maximize_Click" Style="{StaticResource CaptionButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="최대화">
                            <icon:PackIconCodicons Kind="ChromeMaximize" Width="12" Height="12"/>
                        </Button>
                        <Button Click="Close_Click" Style="{StaticResource CaptionCloseButtonStyle}"
                                WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="닫기">
                            <icon:PackIconCodicons Kind="ChromeClose" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--═══ 본문 : 조사개황 요약 카드 + 분류군 화면 ═══════════════════
                 C-3 : 조사개황·조사환경·건강성을 펼친 채로도 종 그리드를 보고 고칠 수 있게 본문 전체를 바깥 스크롤로 감싼다.
                 · 다 들어가면 지금과 같다(스크롤 없음). 모자라면 그리드 칸이 최소 높이(8행 · GridMinHeight)를 지키고 바깥이 스크롤된다.
                 · FillPanel 이 그리드 칸에 '보이는 높이 이하'의 유한한 높이를 준다 — 높이 제한이 없으면 RadGridView 행 가상화가 꺼진다.
                 · 휠 : 그리드 위에서는 그리드가, 그리드가 끝에 닿으면 바깥이 스크롤된다(NestedWheelScroll).
                 ⚠ 여백은 FillPanel 이 아니라 스크롤의 Padding 으로 준다(보이는 높이 계산에 들어가게). -->
            <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Padding="12 12 12 0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" core:NestedWheelScroll.IsEnabled="True">
            <ctrl:FillPanel>

                <!--── 조사개황 : 셸이 한 번만 소유한다(design.md §5.1) ─────────
                     접힘 48px 한 줄. DataContext 는 코드비하인드가 SurveyMeta 싱글턴으로 넣는다. -->
                <Border x:Name="MetaCard" Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}" Padding="16 0">
                    <StackPanel>
                        <Grid Height="{StaticResource MetaCardHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 대분류를 색점 + 글자로 함께 표시한다(색만으로 구분하지 않는다 · §11) -->
                                <Border Width="{StaticResource TaxonDotSize}" Height="{StaticResource TaxonDotSize}"
                                        CornerRadius="{StaticResource TaxonDotRadius}" Margin="0 0 8 0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource GradeNoneBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Project}" Value="방류하천">
                                                    <Setter Property="Background" Value="{StaticResource AppAccentStrongBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Project}" Value="생태현황">
                                                    <Setter Property="Background" Value="{StaticResource BirdBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <TextBlock Text="조사개황" Style="{StaticResource GroupHeaderTextStyle}"/>
                                <Border Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>

                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ProjectText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProject}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>

                                <TextBlock Text="{Binding SiteDisplay, Converter={StaticResource EmptyToDot}}"
                                           Style="{StaticResource SummaryValueTextStyle}" Margin="0"/>
                                <Border Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>

                                <TextBlock Text="{Binding SurveyDateText}"
                                           Style="{StaticResource SummaryValueTextStyle}" Margin="0"/>
                                <Border Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>

                                <TextBlock Text="{Binding CoordinateText}"
                                           Style="{StaticResource SummaryValueTextStyle}" Margin="0"
                                           Foreground="{StaticResource AccentOnSurfaceBrush}"/>
                                <Border Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>

                                <TextBlock Text="{Binding SurveyorWeatherText}"
                                           Style="{StaticResource SummaryLabelTextStyle}" Margin="0"/>
                            </StackPanel>

                            <!-- 분류군별 주석 슬롯 — 관찰형 3종만 문구가 있다 -->
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16 0 8 0"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding DataContext.Taxon.Current,
                                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                                   Converter={StaticResource TaxonToBool},
                                                                   ConverterParameter=Bird}">
                                                <Setter Property="Text"
                                                        Value="관리자 조류 자료에는 대권역·중권역·하천유형·조사기관이 없습니다(내보내기 시 비워짐)"/>
                                            </DataTrigger>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding DataContext.Taxon.Current,
                                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                                   Converter={StaticResource TaxonToBool},
                                                                   ConverterParameter=Mammal}">
                                                <Setter Property="Text"
                                                        Value="관리자 포유류 자료에는 대권역·중권역·하천유형·조사기관이 없습니다(내보내기 시 비워짐)"/>
                                            </DataTrigger>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding DataContext.Taxon.Current,
                                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                                   Converter={StaticResource TaxonToBool},
                                                                   ConverterParameter=AmphibianReptile}">
                                                <Setter Property="Text"
                                                        Value="관리자 양서파충류 자료에는 대권역·중권역·하천유형·조사기관이 없습니다(내보내기 시 비워짐)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- C-2 : 새 지점 — 저장 확인(B-5) → 7개 분류군 입력·지점 비움 → 6칸 유지(압정과 무관 · E4) → 지점 칸으로 -->
                                <Button x:Name="NewSiteButton" Content="새 지점" Style="{StaticResource SmallOutlineButtonStyle}"
                                        Margin="0 0 8 0" Click="NewSite_Click"
                                        AutomationProperties.Name="새 지점"
                                        ToolTipService.ToolTip="입력과 지점을 비우고 다른 지점을 새로 시작합니다. 대분류·연도차수·조사일자·날씨·조사자·조사기관은 압정과 관계없이 그대로 둡니다."/>
                                <Button Content="지도" Style="{StaticResource SmallOutlineButtonStyle}"
                                        Click="Map_Click"
                                        ToolTipService.ToolTip="등록된 지도를 보고 지도를 추가·교체합니다"/>

                                <!-- ⚠ 대분류를 고르기 전에는 접을 수 없다 — 격리 규칙을 눈에서 놓치지 않게 한다(§5.1) -->
                                <ToggleButton x:Name="MetaToggle" IsChecked="True" Margin="8 0 0 0"
                                              Style="{StaticResource SmallOutlineToggleButtonStyle}"
                                              IsEnabled="{Binding HasProject}"
                                              ToolTipService.ToolTip="대분류를 고르기 전에는 접을 수 없습니다">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="펼치기"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding IsChecked, ElementName=MetaToggle}">
                                                            <Setter Property="Text" Value="접기"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 펼침이면 셰브런을 뒤집는다. Style 을 속성 요소로만 준다 —
                                             Style 속성과 Path.Style 을 함께 쓰면 XAML 이 중복 지정으로 막는다. -->
                                        <Path Stroke="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource ChevronPathStyle}">
                                                    <Setter Property="RenderTransformOrigin" Value="0.5 0.5"/>
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding IsChecked, ElementName=MetaToggle}">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="180"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <!-- 값 고정 안내 : 조사개황을 접어도 계속 보여야 한다.
                             저장·내보내기 직전에 "이 값들이 그대로 들어간다"를 알리는 자리다. -->
                        <Border Style="{StaticResource PinnedNoticeBorderStyle}" Margin="0 0 0 8"
                                Visibility="{Binding Pins.HasPins, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <icon:PackIconMaterial Kind="Pin" Width="13" Height="13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource PinnedNoticeForeBrush}"/>
                                <TextBlock Text="{Binding Pins.PinnedNoticeText}" Margin="6 0 0 0"
                                           Style="{StaticResource PinnedNoticeTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <ContentControl Margin="0 0 0 16"
                                        Visibility="{Binding IsChecked, ElementName=MetaToggle,
                                                     Converter={StaticResource BoolToVisibility}}">
                            <ctrl:SurveyOverviewControl/>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <!--── 분류군 본문 : 담당 분류군 하나만 보인다 ─────────────────
                     7개 컨트롤과 7개 VM 싱글턴은 그대로다(자료가 남아 있어야 한다). -->
                <!-- ⚠ 각 EntryControl 은 코드비하인드에서 자기 VM 을 DataContext 로 넣는다.
                     그래서 컨트롤 자신에 건 바인딩은 창 VM 이 아니라 그 분류군 VM 을 본다 —
                     RelativeSource 로 창의 DataContext 를 짚어야 한다(design.md §8).
                     ElementName 으로 잡던 종전 탭 방식에서는 드러나지 않던 함정이다. -->
                <Grid Grid.Row="1" Margin="0 8 0 0" ctrl:FillPanel.Fill="True">
                    <ctrl:FishEntryControl
                        Visibility="{Binding DataContext.Taxon.Current, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TaxonToVisibility}, ConverterParameter=Fish}"/>
                    <ctrl:BenthosEntryControl
                        Visibility="{Binding DataContext.Taxon.Current, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TaxonToVisibility}, ConverterParameter=Benthos}"/>
                    <ctrl:BirdEntryControl
                        Visibility="{Binding DataContext.Taxon.Current, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TaxonToVisibility}, ConverterParameter=Bird}"/>
                    <ctrl:MammalEntryControl
                        Visibility="{Binding DataContext.Taxon.Current, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TaxonToVisibility}, ConverterParameter=Mammal}"/>
                    <ctrl:AmphibianReptileEntryControl
                        Visibility="{Binding DataContext.Taxon.Current, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TaxonToVisibility}, ConverterParameter=AmphibianReptile}"/>
                    <ctrl:HabitatWaterEdgeEntryControl
                        Visibility="{Binding DataContext.Taxon.Current, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TaxonToVisibility}, ConverterParameter=HabitatWaterEdge}"/>
                    <ctrl:WaterQualityEntryControl
                        Visibility="{Binding DataContext.Taxon.Current, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TaxonToVisibility}, ConverterParameter=WaterQuality}"/>
                </Grid>
            </ctrl:FillPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
