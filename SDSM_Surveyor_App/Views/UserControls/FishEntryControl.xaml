<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.FishEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:core="clr-namespace:SDSM_Surveyor_App.Behaviors"
             xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
             xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1224" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance vm:FishEntryViewModel}">

    <!-- 어류 (종 입력형) — 단일 분류군 모드 골격 (README §2 · 시안 3a/3b)
         조사개황은 셸이 소유한다(design.md §5.1) — 여기에는 어류 고유 입력만 둔다.

         세로 : 조사환경 요약 36 → 건강성 요약 36 → 빠른추가 56 → 종 그리드 → 합계 36 → 상태바 48
         ⚠ 우측 결과 레일은 없앴다. 지수·총계가 본문 상단으로 올라와 본문이 약 320px 넓어졌고,
            그 폭이 국명·학명 열로 간다.
         ⚠ 조사환경·건강성을 접으면 종 그리드가 12행 → 20행이 된다. 접힘 상태는 세션에 저장된다. -->

    <Grid Margin="0 0 0 12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- ① 조사환경 (접이식) -->
            <RowDefinition Height="Auto"/>   <!-- ② 건강성   (접이식) -->
            <RowDefinition Height="Auto"/>   <!-- ③ 빠른추가 -->
            <RowDefinition Height="*"/>      <!-- ④ 종 그리드 + 합계 행 -->
            <RowDefinition Height="Auto"/>   <!-- ⑤ 상태 · 액션 -->
        </Grid.RowDefinitions>

        <!--═══ ① 조사환경 ══════════════════════════════════════════════════
             수생태계 건강성 평가 지침의 어류 야장 항목을 담는다.
             ⚠ 하천차수와 비정상종(DE·EF·LE·TU)은 FAI 입력이다 — 빼면 지수가 나오지 않는다.
                하천차수는 M1·M2·M3·M7 의 구간표를 고르고, 비정상종은 M8 의 분자다.
             ⚠ 유폭·수심·수온 등 서식환경 실측값은 저서동물 야장 항목이다(관리자 Fish 모델에 없다).-->
        <ctrl:CollapsibleSummary Grid.Row="0" Title="조사환경"
                                 Caption="지점당 1회 입력하고 접어 두면 종 그리드가 8행 늘어납니다"
                                 IsExpanded="{Binding IsEnvironmentExpanded, Mode=TwoWay}">
            <ctrl:CollapsibleSummary.SummarySlot>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="하천형태" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding HabitatRiverType, Converter={StaticResource EmptyToDot}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>

                    <TextBlock Text="유속" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding HabitatFlowState, Converter={StaticResource EmptyToDot}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>

                    <TextBlock Text="채집도구" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding CollectionTool, Converter={StaticResource EmptyToDot}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>

                    <!-- 흐름상태(채집)와 유속은 양식의 다른 행이다(16행·28행 · B-8) -->
                    <TextBlock Text="흐름상태(채집)" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding CollectionFlowState, Converter={StaticResource EmptyToDot}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>

                    <TextBlock Text="하천차수" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding RiverChasuText}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>

                    <TextBlock Text="하상구성" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding SubstrateSummary}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>

                    <TextBlock Text="비정상종" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding AbnormalSummary}"
                               Style="{StaticResource SummaryValueTextStyle}"/>

                    <!-- 하상구성 합계가 100 이 아니거나 정수가 아닌 값이 있으면 접힌 상태에서도 알린다(B-6) -->
                    <TextBlock Text="{Binding EnvironmentWarning}" Margin="12 0 0 0"
                               Style="{StaticResource InlineWarnTextStyle}"/>
                </StackPanel>
            </ctrl:CollapsibleSummary.SummarySlot>

            <ctrl:CollapsibleSummary.ExpandedSlot>
                <StackPanel>
                    <!-- 1행 : 서식처 · 채집방법 (design.md §2.3 4단 규격) -->
                    <WrapPanel>
                        <StackPanel Style="{StaticResource FormFieldMdStyle}">
                            <TextBlock Text="하천형태" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                         WatermarkContent="Aa-Bb 이행형 등"
                                                         Text="{Binding HabitatRiverType, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldSmStyle}">
                            <TextBlock Text="유속" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                         ToolTipService.ToolTip="양식 28행 흐름상태(유속) — 아주빠름 / 빠름 / 보통 / 느림 / 정체"
                                                         Text="{Binding HabitatFlowState, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldSmStyle}">
                            <TextBlock Text="채집도구" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadComboBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                 ItemsSource="{Binding CollectionTools}"
                                                 SelectedItem="{Binding CollectionTool, Mode=TwoWay}"/>
                        </StackPanel>
                        <!-- 흐름상태(채집) : 양식 16행 '1 여울, 2 흐름, 3 소 (복수)'(B-8 신설).
                             종전에는 VM·세션·내보내기에는 있었는데 화면 칸이 없었다. -->
                        <StackPanel Style="{StaticResource FormFieldMdStyle}">
                            <TextBlock Text="흐름상태(채집)" Style="{StaticResource FormLabelStyle}"/>
                            <ctrl:MultiChoiceBox Options="{Binding CollectionFlowStates}"
                                                 Value="{Binding CollectionFlowState}"
                                                 ToolTipText="채집한 곳의 흐름 — 여러 개를 고를 수 있습니다(여울 / 흐름 / 소)"
                                                 AutomationName="흐름상태(채집)"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="채집시간(분)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="분"
                                                         core:IntegerInput.IsEnabled="True" Text="{Binding CollectionTime, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="하천차수" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadNumericUpDown BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                      Minimum="0" Maximum="7" Value="{Binding RiverChasu, Mode=TwoWay}"
                                                      ToolTipService.ToolTip="FAI M1·M2·M3·M7 의 구간표를 고르는 값입니다. 비어 있으면 지수가 산출되지 않습니다."/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldMdStyle}">
                            <TextBlock Text="조사불가 사유" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                         WatermarkContent="접근불가 / 건천화 / 준설 / 공사중"
                                                         Text="{Binding SurveyUnavailableReason, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTipService.ToolTip="사유가 있으면 등급이 '-'(미평가)가 됩니다. 0종과는 다릅니다."/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- 채집시간이 정수가 아니면(예전 세션 값) 알린다 -->
                    <TextBlock Text="{Binding CollectionTimeWarning}" Margin="0 0 0 4"
                               Style="{StaticResource InlineWarnTextStyle}"/>

                    <!-- 2행 : 하상구성 (%) — 합계 100 -->
                    <StackPanel Orientation="Horizontal" Margin="0 4 0 8">
                        <Border Style="{StaticResource GroupHeaderBarStyle}"/>
                        <TextBlock Style="{StaticResource GroupHeaderTextStyle}"
                                   Text="하상구성 (%) — 합계 100"/>
                        <TextBlock Text="{Binding SubstrateWarning}" Margin="12 0 0 0"
                                   Style="{StaticResource InlineWarnTextStyle}"/>
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="암반 (B)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                         ToolTipService.ToolTip="암반"
                                                         core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Bedrock, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="콘크리트 (C)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                         ToolTipService.ToolTip="콘크리트"
                                                         core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Concrete, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="진흙 (M)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                         ToolTipService.ToolTip="진흙 이하 (&lt;0.063mm)"
                                                         core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Mud, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="모래 (S)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                         ToolTipService.ToolTip="모래 (0.063–2mm)"
                                                         core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Sand, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="잔자갈 (FG)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                         ToolTipService.ToolTip="잔자갈 (2–16mm)"
                                                         core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding FineGravel, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="자갈 (G)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                         ToolTipService.ToolTip="자갈 (16–64mm)"
                                                         core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Gravel, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="작은돌 (SS)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                         ToolTipService.ToolTip="작은돌 (64–256mm)"
                                                         core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding SmallStone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="큰돌 (BS)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                         ToolTipService.ToolTip="큰돌 (&gt;256mm)"
                                                         core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding BigStone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- 3행 : 비정상종(개체수) — FAI M8 · 비고 -->
                    <StackPanel Orientation="Horizontal" Margin="0 4 0 8">
                        <Border Style="{StaticResource GroupHeaderBarStyle}"/>
                        <TextBlock Text="비정상종 (개체수) — FAI M8" Style="{StaticResource GroupHeaderTextStyle}"/>
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="기형 (DE)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="0"
                                                         Text="{Binding DeCount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="지느러미 (EF)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="0"
                                                         Text="{Binding EfCount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="피부 (LE)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="0"
                                                         Text="{Binding LeCount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldXsStyle}">
                            <TextBlock Text="종양 (TU)" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="0"
                                                         Text="{Binding TuCount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormFieldLgStyle}">
                            <TextBlock Text="비고" Style="{StaticResource FormLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </ctrl:CollapsibleSummary.ExpandedSlot>
        </ctrl:CollapsibleSummary>

        <!--═══ ② 건강성 (종전 우측 결과 레일) ═══════════════════════════════
             ⚠ 지수·등급은 SDSM_Core/Ecology 가 계산한다. 여기서는 결과만 그린다. -->
        <ctrl:CollapsibleSummary Grid.Row="1" Margin="0 8 0 0" Title="건강성"
                                 Caption="{Binding HealthCaption}"
                                 IsExpanded="{Binding IsHealthExpanded, Mode=TwoWay}">
            <ctrl:CollapsibleSummary.SummarySlot>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FAI" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding FaiScore, TargetNullValue='-', StringFormat={}{0:N1}}"
                               VerticalAlignment="Center" Margin="0 0 8 0"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AccentOnSurfaceBrush}"/>

                    <!-- 등급 뱃지 : 글자(A~E)가 항상 함께 나온다 -->
                    <Border Margin="0 0 12 0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GradeBadgeBorderStyle}">
                                <Setter Property="Height" Value="{StaticResource GradeBadgeSmallHeight}"/>
                                <Setter Property="MinWidth" Value="28"/>
                                <Setter Property="CornerRadius" Value="{StaticResource GradeBadgeSmallCornerRadius}"/>
                                <Setter Property="Padding" Value="9 0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FaiGrade}" Value="A">
                                        <Setter Property="Background" Value="{StaticResource GradeABrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding FaiGrade}" Value="B">
                                        <Setter Property="Background" Value="{StaticResource GradeBBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding FaiGrade}" Value="C">
                                        <Setter Property="Background" Value="{StaticResource GradeCBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding FaiGrade}" Value="D">
                                        <Setter Property="Background" Value="{StaticResource GradeDBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding FaiGrade}" Value="E">
                                        <Setter Property="Background" Value="{StaticResource GradeEBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FaiGrade, TargetNullValue='-'}" FontSize="13"
                                   Style="{StaticResource GradeBadgeTextStyle}"/>
                    </Border>

                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Text="낮은 항목" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding LowMetricsText}" Style="{StaticResource SummaryValueTextStyle}"/>

                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Style="{StaticResource SummaryValueTextStyle}">
                        <Run Text="총"/>
                        <Run Text="{Binding TotalSpeciesCount, Mode=OneWay}"/><Run Text="종 ·"/>
                        <Run Text="{Binding TotalIndividualCount, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text="개체"/>
                    </TextBlock>

                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Text="보호종" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding ProtectedCount}" Margin="0 0 8 0" VerticalAlignment="Center"
                               FontSize="{StaticResource SummaryFontSize}" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentOnSurfaceBrush}"/>
                    <TextBlock Text="교란종" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding InvasiveCount}" Margin="0 0 12 0" VerticalAlignment="Center"
                               FontSize="{StaticResource SummaryFontSize}" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerTextBrush}"/>

                    <!-- 미입력과 0 은 다르게 저장된다 — 건수를 접힌 줄에서도 알린다 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasMissingCounts, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource VerticalDividerStyle}"/>
                        <icon:PackIconMaterial Kind="AlertCircleOutline" Width="13" Height="13"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerOnSurfaceBrush}"/>
                        <TextBlock Text="{Binding MissingCountText}" Margin="4 0 0 0" VerticalAlignment="Center"
                                   FontSize="{StaticResource SummaryFontSize}"
                                   Foreground="{StaticResource DangerOnSurfaceBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ctrl:CollapsibleSummary.SummarySlot>

            <ctrl:CollapsibleSummary.ExpandedSlot>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!--── 좌 : FAI + M1~M8 막대 ─────────────────────────────-->
                    <StackPanel Grid.Column="0" Width="{StaticResource HealthLeftWidth}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FaiScore, TargetNullValue='-', StringFormat={}{0:N1}}"
                                       Style="{StaticResource ValueTextStyle}"/>
                            <Border Margin="12 0 0 0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GradeBadgeBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaiGrade}" Value="A">
                                                <Setter Property="Background" Value="{StaticResource GradeABrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding FaiGrade}" Value="B">
                                                <Setter Property="Background" Value="{StaticResource GradeBBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding FaiGrade}" Value="C">
                                                <Setter Property="Background" Value="{StaticResource GradeCBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding FaiGrade}" Value="D">
                                                <Setter Property="Background" Value="{StaticResource GradeDBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding FaiGrade}" Value="E">
                                                <Setter Property="Background" Value="{StaticResource GradeEBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FaiGrade, TargetNullValue='-'}"
                                           Style="{StaticResource GradeBadgeTextStyle}"/>
                            </Border>
                            <TextBlock Text="어류 건강성" Margin="12 0 0 0" VerticalAlignment="Bottom"
                                       Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>

                        <!-- M1~M8 막대. 낮은 항목은 색을 달리하고 **이름도 아래에 적는다**(§11) -->
                        <ItemsControl ItemsSource="{Binding MetricBars}" Margin="0 10 0 0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{StaticResource MetricBarWidth}"
                                            Height="{StaticResource MetricBarMaxHeight}"
                                            Margin="0 0 4 0" VerticalAlignment="Bottom"
                                            Background="Transparent"
                                            ToolTipService.ToolTip="{Binding Tooltip}">
                                        <Border VerticalAlignment="Bottom" CornerRadius="2 2 0 0"
                                                Height="{Binding Score, Converter={StaticResource MetricToBarHeight}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AppAccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                            <!-- 시안의 GradeC(#F9A825)는 흰 배경 1.97:1 로 미달이라
                                                                 한 단계 진한 GradeD 를 쓴다(3.08:1 · design.md §3.7) -->
                                                            <Setter Property="Background" Value="{StaticResource GradeDBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0 6 0 0" Style="{StaticResource CaptionTextStyle}">
                            <Run Text="M1~M8 · 낮은 항목"/>
                            <Run Text="{Binding LowMetricsText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource VerticalDividerStyle}"
                            Height="Auto" VerticalAlignment="Stretch" Margin="20 0"/>

                    <!--── 중 : 요약 수치 ─────────────────────────────────────-->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0 0 24 0">
                            <TextBlock Text="총 종수" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding TotalSpeciesCount}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 24 0">
                            <TextBlock Text="총 개체수" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding TotalIndividualCount, StringFormat={}{0:N0}}"
                                       Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 24 0">
                            <TextBlock Text="우점종" Style="{StaticResource CaptionTextStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DominantSpecies}"
                                           Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Margin="6 0 0 0" VerticalAlignment="Bottom"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding DominantShare, TargetNullValue='·', StringFormat={}{0:N1}%}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0 0 24 0">
                            <TextBlock Text="보호종" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding ProtectedCount}" Style="{StaticResource ValueTextStyle}"
                                       Foreground="{StaticResource AppAccentBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 24 0">
                            <TextBlock Text="교란종" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding InvasiveCount}" Style="{StaticResource ValueTextStyle}"
                                       Foreground="{StaticResource DangerTextBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="외래종" Style="{StaticResource CaptionTextStyle}"
                                       ToolTip="FAI M1(국내종 종수)·M7(국내종 개체수) 계산에서 제외되는 종수입니다"/>
                            <TextBlock Text="{Binding ExoticCount}" Style="{StaticResource ValueTextStyle}"
                                       Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--── 우 : 미입력 경고 ───────────────────────────────────-->
                    <Border Grid.Column="3" Style="{StaticResource WarnBoxBorderStyle}" MaxWidth="280"
                            Visibility="{Binding HasMissingCounts, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="AlertCircleOutline" Width="14" Height="14"
                                                   VerticalAlignment="Top" Margin="0 2 6 0"
                                                   Foreground="{StaticResource DangerOnSurfaceBrush}"/>
                            <TextBlock Text="{Binding MissingCountDetail}" Style="{StaticResource WarnBoxTextStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ctrl:CollapsibleSummary.ExpandedSlot>
        </ctrl:CollapsibleSummary>

        <!--═══ ③ 빠른추가 (56px) ═══════════════════════════════════════════-->
        <ctrl:QuickAddBar Grid.Row="2" Margin="0 8 0 0"
                          SearchWatermark="초성으로 종명 검색 (예: ㅊㄱㄱㄴ)"
                          CountWatermark="개체수"
                          Hint="Enter 추가 후 검색창 복귀 · Ctrl+V 엑셀 다중 행 · F2 편집"/>

        <!--═══ ④ 종 그리드 + 합계 행 ═══════════════════════════════════════
             선언 열 폭(고정폭 합 940px) — design.md §7 한도 1,104px 이내.
             ⚠ RadGridView 는 폭 합이 뷰포트를 넘어도 가로 스크롤을 만들지 않고 열을 뭉갠다.
                1280 폭에서 이 값이 유지되는지 확인할 것(§7 · 완료 조건). -->
        <Grid Grid.Row="3" Margin="0 8 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <telerik:RadGridView x:Name="SpeciesGrid" Grid.Row="0"
                                 ItemsSource="{Binding SpeciesEntries}"
                                 AutoGenerateColumns="False"
                                 CanUserInsertRows="True"
                                 NewRowPosition="Bottom"
                                 GroupRenderMode="Flat"
                                 ShowGroupPanel="False"
                                 IsSynchronizedWithCurrentItem="True"
                                 SelectionUnit="Cell"
                                 GridLinesVisibility="Horizontal"
                                 RowIndicatorVisibility="Collapsed"
                                 ClipboardCopyMode="Cells"
                                 CanUserFreezeColumns="False"
                                 IsFilteringAllowed="False"
                                 CanUserSortColumns="False"
                                 RowHeight="{StaticResource GridRowHeight}"
                                 AlternationCount="2"
                                 AlternateRowBackground="{StaticResource RowAltBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 PreviewKeyDown="Grid_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="Grid_PreviewMouseDown"
                                 PreviewMouseRightButtonDown="Grid_PreviewMouseDown">
                <telerik:RadGridView.ContextMenu>
                    <!-- PlacementTarget 을 거쳐 그리드의 DataContext(화면 VM)로 간다 —
                         ContextMenu 는 시각 트리 밖이라 DataContext 상속을 믿으면 안 된다. -->
                    <ContextMenu>
                        <MenuItem Header="이 행 삭제"
                                  Command="{Binding PlacementTarget.DataContext.DeleteRowCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </telerik:RadGridView.ContextMenu>
                <telerik:RadGridView.Columns>

                    <!-- # : 읽기전용 행 번호. 색은 #666(시안 1차본 #999 는 2.85:1 로 미달이었다) -->
                    <telerik:GridViewDataColumn Header="#" Width="40" IsReadOnly="True" IsFilterable="False"
                                                DataMemberBinding="{Binding RowNumber}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RowNumber}" Style="{StaticResource GridIndexTextStyle}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <!-- 국명 : 초성 자동완성 + 보호종·교란종·외래종 뱃지
                         ⚠ 그리드 셀 편집기는 design.md §7 대로 RadAutoCompleteBox 다.
                            빠른추가 바만 RadComboBox 다(두 번 클릭 문제) — 둘을 바꾸지 말 것. -->
                    <telerik:GridViewDataColumn Header="국명" Width="220"
                                                DataMemberBinding="{Binding SpeciesKo}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SpeciesKo, Converter={StaticResource EmptyToDot}}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInvasive}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 보호종 = 강조색 계열 -->
                                    <Border Style="{StaticResource ProtectedBadgeBorderStyle}"
                                            Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ProtectionBadgeText}"
                                                   Style="{StaticResource ProtectedBadgeTextStyle}"/>
                                    </Border>

                                    <!-- 교란종 = 위험색 계열. ⚠ 보호종과 의미가 반대라 색을 분리한다(§11) -->
                                    <Border Style="{StaticResource InvasiveBadgeBorderStyle}"
                                            Visibility="{Binding IsInvasive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="⚠ 교란종" Style="{StaticResource InvasiveBadgeTextStyle}"/>
                                    </Border>

                                    <!-- 외래종 = 중립 회색. FAI 국내종 집계에서 빠진다는 사실 표기다 -->
                                    <Border Style="{StaticResource NeutralBadgeBorderStyle}"
                                            Visibility="{Binding ShowExoticBadge, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="외래종" Style="{StaticResource NeutralBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>

                        <telerik:GridViewDataColumn.CellEditTemplate>
                            <DataTemplate>
                                <telerik:RadAutoCompleteBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}"
                                    SelectionMode="Single" AutoCompleteMode="Suggest"
                                    WatermarkContent="초성으로 종명 검색"
                                    DisplayMemberPath="SpeciesKo"
                                    TextSearchPath="SpeciesKo"
                                    TextSearchMode="Contains"
                                    SelectedItem="{Binding SelectedSpecies, Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{Binding DataContext.SpeciesListSource,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <telerik:RadAutoCompleteBox.FilteringBehavior>
                                        <core:ChosungFilteringBehavior/>
                                    </telerik:RadAutoCompleteBox.FilteringBehavior>
                                </telerik:RadAutoCompleteBox>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellEditTemplate>
                    </telerik:GridViewDataColumn>

                    <!-- 학명 : 자동 상속되지만 잠기지 않는다(조사자가 덮어쓸 수 있다) -->
                    <telerik:GridViewDataColumn Header="학명" Width="*" MinWidth="160"
                                                DataMemberBinding="{Binding SelectedSpecies.SpeciesEn}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedSpecies.SpeciesEn, Converter={StaticResource EmptyToDot}}"
                                           Style="{StaticResource GridScientificNameTextStyle}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <!-- 개체수 : 미입력(null)과 실측 0 을 눈으로 구분한다 -->
                    <telerik:GridViewDataColumn Header="개체수" Width="96" TextAlignment="Right"
                                                DataMemberBinding="{Binding IndividualCount}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <!-- ⚠ Style 을 속성과 속성요소로 함께 주면 XAML 이 중복 지정으로 막는다.
                                     트리거가 필요하므로 속성요소 쪽만 쓴다. -->
                                <TextBlock Text="{Binding IndividualCount, Converter={StaticResource EmptyToDot}}"
                                           ToolTipService.ToolTip="미입력(·)과 실측 0 은 다르게 저장됩니다">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumberTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding IndividualCount, Converter={StaticResource IsEmpty}}">
                                                    <Setter Property="Foreground"
                                                            Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <!-- 자동 상속되는 형질값 (FAI 근거) — 종목록에서 따라온다 -->
                    <telerik:GridViewDataColumn Header="내성도" Width="96" IsReadOnly="True"
                                                DataMemberBinding="{Binding ToleranceText}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ToleranceText}" Style="{StaticResource GridInheritedTextStyle}"
                                           ToolTipService.ToolTip="{Binding GuildTooltip}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <telerik:GridViewDataColumn Header="섭식" Width="96" IsReadOnly="True"
                                                DataMemberBinding="{Binding FeedingText}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FeedingText}" Style="{StaticResource GridInheritedTextStyle}"
                                           ToolTipService.ToolTip="{Binding GuildTooltip}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <telerik:GridViewDataColumn Header="여울성" Width="96" IsReadOnly="True"
                                                DataMemberBinding="{Binding HabitatText}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HabitatText}" Style="{StaticResource GridInheritedTextStyle}"
                                           ToolTipService.ToolTip="{Binding GuildTooltip}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <!-- 상대풍부도 : 읽기전용 파생값(값은 유효하다 · 편집만 안 된다) -->
                    <telerik:GridViewDataColumn Header="상대풍부도" Width="96" IsReadOnly="True"
                                                TextAlignment="Right"
                                                DataMemberBinding="{Binding RelativeAbundance}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ReadOnlyBackBrush}" Margin="-6 -1">
                                    <TextBlock Margin="6 0" Style="{StaticResource GridNumberTextStyle}"
                                               Text="{Binding RelativeAbundance, TargetNullValue='·', StringFormat={}{0:N1}%}"/>
                                </Border>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <!-- 비고 : 조사자 메모. ⚠ 관리자 모델에 대응 필드가 없어 세션 저장 전용이다 -->
                    <telerik:GridViewDataColumn Header="비고" Width="200"
                                                DataMemberBinding="{Binding Note}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Note, Converter={StaticResource EmptyToDot}}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource GridInheritedTextStyle}"
                                               Visibility="{Binding IsJustAdded, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <TextBlock Text="방금 추가" VerticalAlignment="Center"
                                               FontSize="{StaticResource LinkFontSize}"
                                               Foreground="{StaticResource AccentOnSurfaceBrush}"
                                               Visibility="{Binding IsJustAdded, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                </telerik:RadGridView.Columns>

                <!-- 행 표시 규칙
                     · 보호종  = 좌측 3px 강조바 + 국명 SemiBold + 뱃지
                     · 교란종  = 좌측 3px 위험색 바 + 국명 SemiBold + 뱃지  (의미가 반대 · §11)
                     · 방금 추가 = AccentSurface 배경(1.2초)
                     ⚠ 종전에는 보호종 행 글자를 AppAccent(#0381FE)로 칠했는데 14.5px 텍스트에서
                        3.77:1 로 대비 미달이었다. 색 대신 굵기·뱃지·좌측 바로 표시한다. -->
                <telerik:RadGridView.RowStyle>
                    <Style TargetType="telerik:GridViewRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AppAccentStrongBrush}"/>
                                <Setter Property="BorderThickness" Value="3 0 0 0"/>
                                <Setter Property="ToolTip" Value="법정보호종 — 멸종위기 야생생물 / 천연기념물"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInvasive}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource DangerTextBrush}"/>
                                <Setter Property="BorderThickness" Value="3 0 0 0"/>
                                <Setter Property="ToolTip" Value="생태계교란생물 — 보호종과 의미가 반대입니다"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsJustAdded}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
                            </DataTrigger>
                            <!-- 기준자료 이상치 경고(비차단) : 저장·내보내기를 막지 않는다 -->
                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                <Setter Property="ToolTip" Value="{Binding ErrorContent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </telerik:RadGridView.RowStyle>
            </telerik:RadGridView>

            <!-- 빈 상태 (README §11.4) : 빈 그리드를 그대로 두지 않는다.
                 아이콘 + 한 줄 안내 + 다음 행동을 함께 보여 준다.
                 ⚠ Telerik 새 행 줄의 영문 안내는 이 앱에서 한글로 바꾸지 못했다 —
                    그 문구의 리소스 키가 LocalizationManager 를 타지 않는다. 안내는 여기서 한다. -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Margin="0 40 0 0"
                        Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}">
                <icon:PackIconMaterial Kind="PlusBoxOutline" Width="28" Height="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TertiaryForegroundBrush}"/>
                <TextBlock Text="위 빠른추가로 종을 추가하세요" Margin="0 10 0 0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TertiaryForegroundBrush}"/>
                <TextBlock Text="초성으로 종명을 찾고 개체수를 넣은 뒤 Enter · 엑셀에서 Ctrl+V 로 여러 줄도 됩니다"
                           Margin="0 4 0 0" HorizontalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TertiaryForegroundBrush}"/>
            </StackPanel>

            <!--── 합계 행 (36px 고정) : 스크롤과 무관하게 항상 보인다 ────────
                 열 폭을 그리드와 같게 두어 개체수·상대풍부도 아래에 합이 오도록 맞춘다.
                 맨 끝 칸은 세로 스크롤바 폭만큼의 여백이다(그리드는 스크롤바를 항상 띄운다). -->
            <Border Grid.Row="1" Style="{StaticResource GridTotalRowBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Margin="8 0 0 0" Style="{StaticResource GridTotalTextStyle}"
                               Text="{Binding TotalSpeciesCount, StringFormat=합계 {0}종}"/>

                    <TextBlock Grid.Column="3" Margin="0 0 8 0" HorizontalAlignment="Right"
                               Style="{StaticResource GridTotalTextStyle}"
                               Text="{Binding TotalIndividualCount, StringFormat={}{0:N0}}"/>

                    <TextBlock Grid.Column="7" Margin="0 0 8 0" HorizontalAlignment="Right"
                               Style="{StaticResource GridTotalTextStyle}"
                               Text="{Binding TotalShareText}"/>

                    <Border Grid.Column="9" Width="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
                </Grid>
            </Border>
        </Grid>

        <!--═══ ⑤ 상태 · 액션 바 (7개 화면 공유) ═══════════════════════════-->
        <ctrl:TaxonStatusBar Grid.Row="4" Margin="0 8 0 0" WarningText="{Binding WarningText}">
            <ctrl:TaxonStatusBar.Summary>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalSpeciesCount, StringFormat=총 {0}종}" FontWeight="SemiBold"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalIndividualCount, StringFormat= · {0:N0}개체}" Margin="4 0 0 0"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                </StackPanel>
            </ctrl:TaxonStatusBar.Summary>
            <ctrl:TaxonStatusBar.Actions>
                <StackPanel Orientation="Horizontal">
                    <!-- 위험 : 가장 왼쪽 · 경고색 글자 (주요 버튼과 멀리 떼어 놓는다) -->
                    <telerik:RadButton Command="{Binding PruneEmptyCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       Foreground="{StaticResource DangerActionForeBrush}"
                                       ToolTipService.ToolTip="국명·개체수가 모두 빈 행을 제거합니다">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteSweepOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="빈 행 정리" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <!-- 조사는 했으나 한 종도 확인되지 않은 지점을 명시적으로 선언한다(12_CALC_FIX §2-1) -->
                    <telerik:RadToggleButton IsChecked="{Binding NoSpeciesDeclared, Mode=TwoWay}"
                                             Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                             ToolTipService.ToolTip="조사는 수행했으나 한 종도 확인되지 않은 경우 선택합니다. 점수 0 · 등급 E 로 산정됩니다. 조사불가 사유가 있으면 그쪽이 우선합니다.">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="CheckboxBlankOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="출현종 없음(0종)" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadToggleButton>

                    <telerik:RadButton Command="{Binding SaveTemporaryCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="임시 저장" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportBulkCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       ToolTipService.ToolTip="관리자 일괄입력용(전치 양식) · 현행 관리자 Import 취합용">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="일괄입력 엑셀" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <!-- 주요 : 가장 오른쪽 · 채운 강조색 -->
                    <Button Command="{Binding ExportExcelCommand}" Padding="{StaticResource ActionButtonPadding}"
                                       Style="{StaticResource PrimaryActionButtonStyle}"
                                       ToolTipService.ToolTip="보고서·기록용 · 조사개황/출현종/FAI 건강성평가 시트">
                        <!-- 색은 버튼 템플릿의 TextElement.Foreground 가 상태별로 물려준다.
                             여기서 다시 지정하면 비활성·마우스오버에서 어긋난다. -->
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="보고서 엑셀" Margin="4 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ctrl:TaxonStatusBar.Actions>
        </ctrl:TaxonStatusBar>
    </Grid>
</UserControl>
