<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.QuickAddBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" d:DesignWidth="1224"
             x:Name="Root">

    <!-- 빠른추가 바 (56px · README §2.6)
         5개 화면(어류·저서·조류·포유류·양서파충류)이 같은 바를 쓴다.

         키보드 흐름 : 초성 검색 → (자동) 개체수 → Enter → 행 추가 → (자동) 검색창 복귀
         ⚠ RadAutoCompleteBox 가 아니라 **RadComboBox** 다 — 자동완성 + 커스텀 필터 조합은
            선택하려면 두 번 클릭해야 한다(90_TECH_NOTES §2 · design.md §7). 바꾸지 말 것.
         ⚠ 초성 필터는 VM(`FilterQuick`)이 `ChosungHelper` 로 한다. -->
    <Border Style="{StaticResource CardBorderStyle}" Padding="16 0"
            Height="{StaticResource QuickAddBarHeight}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="빠른추가" Style="{StaticResource GroupHeaderTextStyle}" Margin="0 0 12 0"/>

                <!-- 종명 검색 : 강조색 테두리 + 돋보기. 이 앱에서 가장 많이 쓰는 입력칸이다.
                     ⚠ 콤보 자체에는 Style 을 주지 않는다 — BorderThickness·Background 만
                        개별 속성으로 꺼서 바깥 Border 의 파란 테두리와 겹치지 않게 한다.
                     ⚠ Magnify Kind 는 MahApps.Metro.IconPacks.Material.dll 대조 확인함(design.md §9). -->
                <Border Style="{StaticResource SearchBoxBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <icon:PackIconMaterial Grid.Column="0" Kind="Magnify"
                                               Width="{StaticResource SearchIconSize}"
                                               Height="{StaticResource SearchIconSize}"
                                               Margin="10 0 0 0" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentOnSurfaceBrush}"/>

                        <!-- 바깥 Border 가 이미 36 이다. 콤보에 다시 36 을 주면
                             테두리·패딩만큼 넘쳐서 잘린다 — 남은 높이를 채우게 둔다. -->
                        <telerik:RadComboBox x:Name="SpeciesBox" Grid.Column="1"
                                             VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                             BorderThickness="0" Background="Transparent"
                                             IsEditable="True" IsTextSearchEnabled="False" IsFilteringEnabled="False"
                                             OpenDropDownOnFocus="True" StaysOpenOnEdit="True"
                                             EmptyText="{Binding SearchWatermark, ElementName=Root}"
                                             DisplayMemberPath="SpeciesKo"
                                             ItemsSource="{Binding FilteredQuick}"
                                             Text="{Binding QuickSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             SelectedItem="{Binding QuickSpecies, Mode=TwoWay}"
                                             AutomationProperties.Name="종명 초성 검색"/>
                    </Grid>
                </Border>

                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" x:Name="CountBox"
                                             Width="{StaticResource FieldXs}" Height="{StaticResource InputHeight}"
                                             Margin="8 0 0 0"
                                             WatermarkContent="{Binding CountWatermark, ElementName=Root}"
                                             Text="{Binding QuickCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="CountBox_PreviewKeyDown"
                                             AutomationProperties.Name="개체수"/>

                <Button Content="추가" Margin="8 0 0 0" Height="{StaticResource InputHeight}"
                                   Padding="16 0" Command="{Binding AddQuickCommand}"
                                   Style="{StaticResource PrimaryActionButtonStyle}"/>

                <!-- 종목록 팝업(발주처 요구 2026-09-08) : 담당 분류군의 등록 종 전체를 보고 고른다.
                     ⚠ SmallOutlineButtonStyle 은 Height 를 28 로 세팅한다. 바 안의 다른 칸(36)과
                        맞추려고 로컬 Height 를 준다 — 로컬 값이 스타일 세터를 이긴다. -->
                <Button Content="종목록" Margin="8 0 0 0" Height="{StaticResource InputHeight}"
                        Padding="14 0" Click="SpeciesCatalog_Click"
                        Style="{StaticResource SmallOutlineButtonStyle}"
                        ToolTipService.ToolTip="담당 분류군의 등록 종 전체를 보고 야장에 넣거나 엑셀로 내려받습니다"
                        AutomationProperties.Name="담당 분류군 종목록 보기"/>

                <!-- 누른 행을 지운다. 그리드 우클릭 메뉴와 같은 명령이다.
                     종목록에서 개체수 없이 넣은 행과 수동 입력이 겹쳤을 때 쓴다. -->
                <Button Content="행 삭제" Margin="8 0 0 0" Height="{StaticResource InputHeight}"
                        Padding="14 0" Command="{Binding DeleteRowCommand}"
                        Style="{StaticResource SmallOutlineButtonStyle}"
                        Foreground="{StaticResource DangerActionForeBrush}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTipService.ToolTip="지울 행을 그리드에서 먼저 누르세요. 마우스 오른쪽 버튼으로도 지울 수 있습니다"
                        AutomationProperties.Name="고른 행 삭제"/>

            </StackPanel>

            <!-- 안내 문구는 남는 폭(*)에 둔다.
                 ⚠ 왼쪽 StackPanel 은 Auto 라 안내 문구까지 담으면 바가 통째로 넘친다
                    (조류·포유류·양서파충류는 안내가 길어 45~56px 초과했다). 여기서는
                    남는 폭만 쓰고 모자라면 말줄임표로 자른다 — 입력칸은 절대 밀리지 않는다. -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>

                <!-- ⚠ CaptionTextStyle 이 TextWrapping="Wrap" 을 준다. 높이 제약이 없으면 Wrap 이
                        TextTrimming 을 이겨 두 줄로 접힌다 — 로컬 NoWrap 으로 눌러야 말줄임이 실제로 된다. -->
                <TextBlock Grid.Column="1" Text="{Binding Hint, ElementName=Root}" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0 0 12 0"
                           ToolTipService.ToolTip="{Binding Hint, ElementName=Root}"
                           Foreground="{StaticResource TertiaryForegroundBrush}"/>
            </Grid>

            <!-- 방금 추가 칩 : 최근 1건을 1.2초간 보여 준다(연속 입력 중 "지금 들어간 게 이거다") -->
            <Border Grid.Column="2" Style="{StaticResource JustAddedChipBorderStyle}"
                    Visibility="{Binding HasLastAdded, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource JustAddedChipTextStyle}"
                           Text="{Binding LastAddedLabel, StringFormat=방금 추가 · {0}}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
