<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.HabitatWaterEdgeEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
             xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="740"
             d:DataContext="{d:DesignInstance vm:HabitatWaterEdgeEntryViewModel}">

    <UserControl.Resources>
        <Style x:Key="HwCaption" TargetType="TextBlock" BasedOn="{StaticResource FormLabelStyle}"/>
        <Style x:Key="HwItemLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HwBankTag" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 4 0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ① 서식수변 고유 입력 (조사개황은 셸이 소유 · §5-1-4)
             2칸뿐이라 접기 토글을 두지 않는다 — 접을 이유가 없는 카드에 토글만 남으면 군더더기다. -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                    <Border Style="{StaticResource GroupHeaderBarStyle}"/>
                    <TextBlock Text="특이사항" Style="{StaticResource GroupHeaderTextStyle}"/>
                    <TextBlock Margin="12 0 0 0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                               Text="조사불가 사유는 등급 산정에 쓰이므로 공통 조사개황이 아니라 여기 둔다"/>
                </StackPanel>
                <WrapPanel>
                    <StackPanel Style="{StaticResource FormFieldMdStyle}">
                        <TextBlock Text="조사불가시" Style="{StaticResource FormLabelStyle}"/>
                        <telerik:RadWatermarkTextBox Height="{StaticResource InputHeight}"
                                                     WatermarkContent="접근불가"
                                                     Text="{Binding SurveyUnavailableReason, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTipService.ToolTip="서식수변의 조사불가 사유는 '접근불가' 하나뿐이다(어류 FAI 는 4종)."/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FormFieldLgStyle}">
                        <TextBlock Text="비고" Style="{StaticResource FormLabelStyle}"/>
                        <telerik:RadWatermarkTextBox Height="{StaticResource InputHeight}"
                                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ② 좌: 평가 항목 10개 / 우: HRI 레일 -->
        <Grid Grid.Row="1" Margin="0 8 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*" MinWidth="{StaticResource RailMinWidth}" MaxWidth="{StaticResource RailMaxWidth}"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Padding="14" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="평가 항목 ([별표5] 점수 선택 · 좌/우안 항목은 자동 평균)" FontWeight="SemiBold" Margin="0 0 0 10"
                                   Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>

                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="1. 자연적 종횡사주" Style="{StaticResource HwItemLabel}"/>
                            <telerik:RadComboBox Grid.Column="1" Width="230" HorizontalAlignment="Left"
                                ItemsSource="{Binding Opt1}" DisplayMemberPath="Display" SelectedItem="{Binding S1, Mode=TwoWay}"/>
                        </Grid>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="2. 하도 자연성 (좌/우안)" Style="{StaticResource HwItemLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="좌" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt2}" DisplayMemberPath="Display" SelectedItem="{Binding B2L, Mode=TwoWay}"/>
                                <TextBlock Text="우" Margin="10 0 4 0" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt2}" DisplayMemberPath="Display" SelectedItem="{Binding B2R, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="3. 유속 다양성" Style="{StaticResource HwItemLabel}"/>
                            <telerik:RadComboBox Grid.Column="1" Width="230" HorizontalAlignment="Left"
                                ItemsSource="{Binding Opt3}" DisplayMemberPath="Display" SelectedItem="{Binding S3, Mode=TwoWay}"/>
                        </Grid>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="4. 하천변 폭" Style="{StaticResource HwItemLabel}"/>
                            <telerik:RadComboBox Grid.Column="1" Width="230" HorizontalAlignment="Left"
                                ItemsSource="{Binding Opt4}" DisplayMemberPath="Display" SelectedItem="{Binding S4, Mode=TwoWay}"/>
                        </Grid>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="5. 저수로 하안공 (좌/우안)" Style="{StaticResource HwItemLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="좌" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt5}" DisplayMemberPath="Display" SelectedItem="{Binding B5L, Mode=TwoWay}"/>
                                <TextBlock Text="우" Margin="10 0 4 0" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt5}" DisplayMemberPath="Display" SelectedItem="{Binding B5R, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="6. 제방하안 재료 (좌/우안)" Style="{StaticResource HwItemLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="좌" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt6}" DisplayMemberPath="Display" SelectedItem="{Binding B6L, Mode=TwoWay}"/>
                                <TextBlock Text="우" Margin="10 0 4 0" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt6}" DisplayMemberPath="Display" SelectedItem="{Binding B6R, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="7. 저질 상태" Style="{StaticResource HwItemLabel}"/>
                            <telerik:RadComboBox Grid.Column="1" Width="230" HorizontalAlignment="Left"
                                ItemsSource="{Binding Opt7}" DisplayMemberPath="Display" SelectedItem="{Binding S7, Mode=TwoWay}"/>
                        </Grid>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="8. 횡구조물" Style="{StaticResource HwItemLabel}"/>
                            <telerik:RadComboBox Grid.Column="1" Width="230" HorizontalAlignment="Left"
                                ItemsSource="{Binding Opt8}" DisplayMemberPath="Display" SelectedItem="{Binding S8, Mode=TwoWay}"/>
                        </Grid>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="9. 제외지 토지 이용 (좌/우안)" Style="{StaticResource HwItemLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="좌" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt9}" DisplayMemberPath="Display" SelectedItem="{Binding B9L, Mode=TwoWay}"/>
                                <TextBlock Text="우" Margin="10 0 4 0" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt9}" DisplayMemberPath="Display" SelectedItem="{Binding B9R, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="10. 제내지 토지 이용 (좌/우안)" Style="{StaticResource HwItemLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="좌" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt10}" DisplayMemberPath="Display" SelectedItem="{Binding B10L, Mode=TwoWay}"/>
                                <TextBlock Text="우" Margin="10 0 4 0" Style="{StaticResource HwBankTag}"/>
                                <telerik:RadComboBox Width="210" ItemsSource="{Binding Opt10}" DisplayMemberPath="Display" SelectedItem="{Binding B10R, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ③ HRI 레일 : 합계 → 점수 → 등급 순으로 계산 과정을 보여준다(§5-2-4) -->
            <ctrl:ResultRail Grid.Column="1" Header="서식·수변환경 평가 (HRI)">
                <ctrl:ResultRail.Body>
                    <StackPanel>
                        <Grid Style="{StaticResource RailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="선택 현황" Style="{StaticResource RailLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedCountText}" Style="{StaticResource RailValueStyle}"/>
                        </Grid>
                        <Grid Style="{StaticResource RailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="① 항목 합계" Style="{StaticResource RailLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource RailValueStyle}"/>
                        </Grid>
                        <Grid Style="{StaticResource RailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="② 평가점수 (합÷2)" Style="{StaticResource RailLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ScoreText}" Style="{StaticResource RailValueStyle}"/>
                        </Grid>

                        <Border Style="{StaticResource RailDividerStyle}"/>

                        <TextBlock Text="③ 평가등급" Style="{StaticResource RailValueStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0 6 0 0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource ValueTextStyle}"/>
                            <Border Margin="12 0 0 0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GradeBadgeBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GradeText}" Value="A">
                                                <Setter Property="Background" Value="{StaticResource GradeABrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding GradeText}" Value="B">
                                                <Setter Property="Background" Value="{StaticResource GradeBBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding GradeText}" Value="C">
                                                <Setter Property="Background" Value="{StaticResource GradeCBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding GradeText}" Value="D">
                                                <Setter Property="Background" Value="{StaticResource GradeDBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding GradeText}" Value="E">
                                                <Setter Property="Background" Value="{StaticResource GradeEBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding GradeText}" Style="{StaticResource GradeBadgeTextStyle}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource RailDividerStyle}"/>

                        <!-- ⚠ 미평가(`-`)와 0점·E등급은 다르다(_excel_formula_audit §5-5).
                             10개를 전부 0점으로 골랐으면 그것은 평가한 것이다. -->
                        <TextBlock Text="{Binding EvaluationStateText}" TextWrapping="Wrap"
                                   Style="{StaticResource RailValueStyle}"/>
                        <TextBlock Margin="0 8 0 0" Style="{StaticResource CaptionTextStyle}"
                                   Text="[별표5] 기준 · A≥80 · B≥60 · C≥40 · D≥20 · E"/>
                        <TextBlock Margin="0 6 0 0" Style="{StaticResource CaptionTextStyle}"
                                   Text="10개를 전부 0점으로 골라도 미평가가 아닙니다 — 0 · E 로 산정됩니다."/>
                        <TextBlock Margin="0 6 0 0" Style="{StaticResource CaptionTextStyle}"
                                   Text="조사불가 사유는 '접근불가' 하나뿐입니다(어류 FAI 와 다릅니다)."/>
                    </StackPanel>
                </ctrl:ResultRail.Body>
            </ctrl:ResultRail>
        </Grid>

        <!-- ④ 상태 · 액션 바 (7개 화면 공유) -->
        <ctrl:TaxonStatusBar Grid.Row="2" Margin="0 8 0 0">
            <ctrl:TaxonStatusBar.Summary>
                <TextBlock Text="{Binding SelectedCountText}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
            </ctrl:TaxonStatusBar.Summary>
            <ctrl:TaxonStatusBar.Actions>
                <StackPanel Orientation="Horizontal">
                    <telerik:RadButton Command="{Binding SaveTemporaryCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="임시 저장" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportBulkCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       ToolTipService.ToolTip="관리자 일괄입력용(레거시 양식) · 현행 관리자 Import 취합용">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="일괄입력용" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportExcelCommand}" Padding="{StaticResource ActionButtonPadding}"
                                       Background="{StaticResource PrimaryActionBackBrush}"
                                       Foreground="{StaticResource PrimaryActionForeBrush}"
                                       ToolTipService.ToolTip="보고서·기록용 · 조사개황/평가항목/건강성평가(HRI) 시트">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="보고서 엑셀" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>
            </ctrl:TaxonStatusBar.Actions>
        </ctrl:TaxonStatusBar>
    </Grid>
</UserControl>
