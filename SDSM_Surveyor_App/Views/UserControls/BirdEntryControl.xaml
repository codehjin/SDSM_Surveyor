<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.BirdEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:core="clr-namespace:SDSM_Surveyor_App.Behaviors"
             xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
             xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1224" d:DesignHeight="540"
             d:DataContext="{d:DesignInstance vm:BirdEntryViewModel}">

    <!-- ══ 관찰형 — 조류 14열 (06_DESIGN_REBUILD §5-2-2 · §5-2-4) ═══════════════════
         14열을 하나도 줄이지 않는다(§3-6).

         재배치 전 : 1행 고정폭 합 1,500 px → 가용 1,224 를 276 초과.
                     Telerik 은 가로 스크롤을 만들지 않고 **열을 뭉갰다**(일반명 190 → 86 px).
         재배치 후 : 분류 4칸을 2행으로 내리고 폭을 규격화 → 1행 고정 992 + 특징 232 = 1,224.

           1행 : 일반명 168 · 개체수 84 · 학명 150 · 목 78 · 과 78
                 · 위도 92 · 경도 92 · 특징 * · 특이사항 140 · 구분 110   (고정 합 992)
           2행 : 도래유형 · 대항목 · 세부항목 · 서식유형  (분류 4칸 · 상시 표시)

         개체수는 조류의 주 측정값이라 **1행에 남긴다**(엑셀 [국명, 개체수] 붙여넣기 정렬).
         ══════════════════════════════════════════════════════════════════════════ -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- ① 요약 스트립(36px) -->
            <RowDefinition Height="Auto"/>  <!-- ② 빠른 추가 -->
            <RowDefinition Height="*"/>     <!-- ③ 관찰 그리드(2단 행) -->
            <RowDefinition Height="Auto"/>  <!-- ④ 상태 · 액션 -->
        </Grid.RowDefinitions>

        <!--═══ 요약 스트립 (36px) ═══════════════════════════════════════
             관찰형은 결과 레일을 두지 않는다(design.md §5.2) — 레일을 두면 그리드가
             300px 좁아져 2단 행의 1행 열이 안 들어간다. 대신 한 줄 요약을 위에 둔다.
             ⚠ 보호종과 교란종은 의미가 반대라 색과 숫자를 분리해 적는다(§11). -->
        <Border Grid.Row="0" Style="{StaticResource SummaryRowBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="조류" Style="{StaticResource GroupHeaderTextStyle}"/>
                <Border Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>

                <TextBlock Style="{StaticResource SummaryValueTextStyle}">
                    <Run Text="총"/>
                    <Run Text="{Binding TotalSpeciesCount, Mode=OneWay}"/><Run Text="종 ·"/>
                    <Run Text="{Binding TotalIndividualCount, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text="개체"/>
                </TextBlock>

                <Border Style="{StaticResource VerticalDividerStyle}"/>
                <TextBlock Text="보호종" Style="{StaticResource SummaryLabelTextStyle}"/>
                <TextBlock Text="{Binding ProtectedCount}" Margin="0 0 8 0" VerticalAlignment="Center"
                           FontSize="{StaticResource SummaryFontSize}" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentOnSurfaceBrush}"/>
                <TextBlock Text="교란종" Style="{StaticResource SummaryLabelTextStyle}"/>
                <TextBlock Text="{Binding InvasiveCount}" VerticalAlignment="Center"
                           FontSize="{StaticResource SummaryFontSize}" FontWeight="SemiBold"
                           Foreground="{StaticResource DangerTextBrush}"/>
            </StackPanel>
        </Border>

        <ctrl:QuickAddBar Grid.Row="1" Margin="0 8 0 8"
                          SearchWatermark="종명 초성 검색 (예: ㅊㄷㅇㄹ)"
                          CountWatermark="개체수"
                          Hint="종 선택 후 개체수 입력 → Enter · 엑셀에서 [국명, 개체수]를 복사해 그리드에 Ctrl+V"/>

        <ctrl:ObservationGrid Grid.Row="2" Rows="{Binding Entries}">
            <!-- ── 1행 10열 · 고정 합 992 + 특징 232 = 1,224 ──────────────────────── -->
            <telerik:GridViewDataColumn Header="일반명" Width="168" DataMemberBinding="{Binding SpeciesKo}">
                <telerik:GridViewDataColumn.CellTemplate>
                    <DataTemplate>
                        <!-- 같은 종이 다른 행에도 있으면 '같은 종 n행'(B-1 · 관찰형은 합치지 않고 알리기만 한다)
                             공식 종목록에 없는 국명이면 '목록 밖'(B-4 · 국명은 그대로 저장한다) -->
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SameSpeciesBadgeBorderStyle}">
                                <TextBlock Text="{Binding SameSpeciesText}" Style="{StaticResource CheckBadgeTextStyle}"/>
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource UnlistedBadgeBorderStyle}">
                                <TextBlock Text="목록 밖" Style="{StaticResource CheckBadgeTextStyle}"/>
                            </Border>
                            <TextBlock Text="{Binding SpeciesKo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </telerik:GridViewDataColumn.CellTemplate>

                <telerik:GridViewDataColumn.CellEditTemplate>
                    <DataTemplate>
                        <telerik:RadAutoCompleteBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" SelectionMode="Single" AutoCompleteMode="Suggest"
                            WatermarkContent="초성 검색 (예: ㅊㄷㅇㄹ)"
                            DisplayMemberPath="SpeciesKo" TextSearchPath="SpeciesKo" TextSearchMode="Contains"
                            SelectedItem="{Binding SelectedSpecies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding DataContext.SpeciesListSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <telerik:RadAutoCompleteBox.FilteringBehavior>
                                <core:ChosungFilteringBehavior/>
                            </telerik:RadAutoCompleteBox.FilteringBehavior>
                        </telerik:RadAutoCompleteBox>
                    </DataTemplate>
                </telerik:GridViewDataColumn.CellEditTemplate>
            </telerik:GridViewDataColumn>

            <!-- 개체수 : 국명 바로 옆 (엑셀 [국명,개체수] 2열 붙여넣기 정렬) -->
            <telerik:GridViewDataColumn Header="개체수" Width="84" DataMemberBinding="{Binding IndividualCount}"
                                        DataFormatString="{}{0:N0}" TextAlignment="Right"/>
            <telerik:GridViewDataColumn Header="학명" Width="150" DataMemberBinding="{Binding SpeciesEn}"/>
            <telerik:GridViewDataColumn Header="목" Width="78" DataMemberBinding="{Binding OrderKo}"/>
            <telerik:GridViewDataColumn Header="과" Width="78" DataMemberBinding="{Binding FamilyKo}"/>
            <telerik:GridViewDataColumn Header="위도" Width="92" IsFilterable="False"
                                        DataMemberBinding="{Binding Lat}" DataFormatString="{}{0:N6}" TextAlignment="Right"/>
            <telerik:GridViewDataColumn Header="경도" Width="92" IsFilterable="False"
                                        DataMemberBinding="{Binding Lng}" DataFormatString="{}{0:N6}" TextAlignment="Right"/>
            <telerik:GridViewDataColumn Header="특징" Width="*" MinWidth="120" DataMemberBinding="{Binding Feature}"/>
            <telerik:GridViewDataColumn Header="특이사항" Width="140" DataMemberBinding="{Binding Note}"/>
            <telerik:GridViewDataColumn Header="구분" Width="110" IsReadOnly="True"
                                        DataMemberBinding="{Binding ProtectionText}"
                                        ToolTipService.ToolTip="공식 종목록의 법정보호종·생태계교란생물 표기(자동)"/>

            <!-- ── 2행 : 분류 4칸 (상시 표시 — 접거나 감추지 않는다) ─────────────────
                 도래유형은 목록 선택이라 콤보로 둔다. 나머지 셋은 자유 입력이다. -->
            <ctrl:ObservationGrid.RowDetails>
                <DataTemplate>
                    <Border Background="{StaticResource Row2LineBrush}" Height="{StaticResource GridRow2LineHeight}">
                        <StackPanel Style="{StaticResource RowDetailsPanelStyle}">
                            <TextBlock Text="╰▸ 분류" Width="66" Style="{StaticResource RowDetailsTagStyle}"/>

                            <TextBlock Text="도래유형" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadComboBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="150" Margin="0 0 16 0"
                                ItemsSource="{Binding DataContext.MigratoryTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedItem="{Binding MigratoryType, Mode=TwoWay}"
                                EmptyText="텃새/여름철새…"/>

                            <TextBlock Text="대항목" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="150" Margin="0 0 16 0" WatermarkContent="·"
                                                         Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="세부항목" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="150" Margin="0 0 16 0" WatermarkContent="·"
                                                         Text="{Binding CategoryDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="서식유형" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="150" WatermarkContent="·"
                                                         Text="{Binding HabitatType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ctrl:ObservationGrid.RowDetails>
        </ctrl:ObservationGrid>

        <!-- ③ 상태 · 액션 바 : 관찰형은 결과 레일을 두지 않는다(§5-1-3) -->
        <!-- 빈 상태 (README §11.4) -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False" Margin="0 40 0 0"
                    Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}">
            <icon:PackIconMaterial Kind="PlusBoxOutline" Width="28" Height="28"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TertiaryForegroundBrush}"/>
            <TextBlock Text="위 빠른추가로 종을 추가하세요" Margin="0 10 0 0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TertiaryForegroundBrush}"/>
            <TextBlock Text="초성으로 종명을 찾고 수량을 넣은 뒤 Enter · 엑셀에서 Ctrl+V 로 여러 줄도 됩니다"
                       Margin="0 4 0 0" HorizontalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource TertiaryForegroundBrush}"/>
        </StackPanel>

        <ctrl:TaxonStatusBar Grid.Row="3" Margin="0 8 0 0">
            <ctrl:TaxonStatusBar.Summary>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalSpeciesCount, StringFormat=총 {0}종}" FontWeight="SemiBold"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalIndividualCount, StringFormat= · {0:N0}개체}" Margin="4 0 0 0"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                </StackPanel>
            </ctrl:TaxonStatusBar.Summary>
            <ctrl:TaxonStatusBar.Actions>
                <StackPanel Orientation="Horizontal">
                    <telerik:RadButton Command="{Binding PruneEmptyCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       Foreground="{StaticResource DangerActionForeBrush}"
                                       ToolTipService.ToolTip="국명·개체수가 모두 빈 행을 제거합니다">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteSweepOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="빈 행 정리" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding AddRowCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="PlusBoxOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="행 추가" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding SaveTemporaryCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="임시 저장" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportBulkCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       ToolTipService.ToolTip="관리자 일괄입력용(레거시 양식) · 현행 관리자 Import 취합용">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="일괄입력용" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <Button Command="{Binding ExportExcelCommand}" Padding="{StaticResource ActionButtonPadding}"
                                       Style="{StaticResource PrimaryActionButtonStyle}"
                                       ToolTipService.ToolTip="보고서·기록용 · 조사개황/출현종/출현종요약 시트">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="보고서 엑셀" Margin="4 0 0 0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ctrl:TaxonStatusBar.Actions>
        </ctrl:TaxonStatusBar>
    </Grid>
</UserControl>
