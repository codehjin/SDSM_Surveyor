<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.BirdEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:core="clr-namespace:SDSM_Surveyor_App.Behaviors"
             xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
             xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="740"
             d:DataContext="{d:DesignInstance vm:BirdEntryViewModel}">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- ① 조사환경(접이식) -->
            <RowDefinition Height="*"/>     <!-- ② 빠른추가 + 관찰 그리드 -->
            <RowDefinition Height="Auto"/>  <!-- 하단 상태바/액션 -->
        </Grid.RowDefinitions>

        <!-- ① 조사환경 : 조사개황은 셸이 소유한다(§5-1-4) -->
        <Border Grid.Row="0" Margin="2" Padding="14" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="조사환경" Style="{StaticResource SubHeaderTextStyle}" Margin="0"/>
                        <TextBlock Text="관리자 조류 자료에는 대권역·중권역·하천유형·조사기관이 없습니다(내보내기 시 비워짐)"
                                   Margin="10 0 0 0" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                    <telerik:RadToggleButton Grid.Column="1" x:Name="MetaToggle" IsChecked="True" Padding="12 4"
                                             Content="접기 / 펼치기"/>
                </Grid>

                <StackPanel Margin="0 10 0 0"
                            Visibility="{Binding IsChecked, ElementName=MetaToggle, Converter={StaticResource BoolToVisibility}}">
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ② 빠른 추가 바 + 관찰 그리드 -->
        <Grid Grid.Row="1" Margin="2 8 2 2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 빠른 추가 : 초성 검색 → 개체수 → Enter/추가 (그리드 편집 마찰 없이 빠르게 입력) -->
            <Border Grid.Row="0" Margin="0 0 0 8" Padding="10 8" Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="종 빠른 추가" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 12 0"/>
                    <telerik:RadComboBox x:Name="QuickSpeciesBox" Width="260"
                        IsEditable="True" IsTextSearchEnabled="False" IsFilteringEnabled="False"
                        OpenDropDownOnFocus="True" StaysOpenOnEdit="True"
                        EmptyText="종명 초성 검색 (예: ㅊㄷㅇㄹ)"
                        DisplayMemberPath="SpeciesKo"
                        ItemsSource="{Binding FilteredQuick}"
                        Text="{Binding QuickSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding QuickSpecies, Mode=TwoWay}"/>
                    <telerik:RadWatermarkTextBox x:Name="QuickCountBox" Width="90" Margin="8 0 0 0"
                        WatermarkContent="개체수"
                        Text="{Binding QuickCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PreviewKeyDown="QuickCountBox_PreviewKeyDown"/>
                    <telerik:RadButton Content="추가" Margin="8 0 0 0" Padding="16 4" Command="{Binding AddQuickCommand}"/>
                    <TextBlock Text="종 선택 후 개체수 입력 → Enter · 엑셀에서 [국명, 개체수]를 복사해 그리드에 Ctrl+V"
                               VerticalAlignment="Center" Margin="12 0 0 0" Style="{StaticResource CaptionTextStyle}"/>
                </StackPanel>
            </Border>

            <!-- 관찰 그리드 (1행 = 1출현기록) : 관리자 Bird 전 필드 -->
            <telerik:RadGridView Grid.Row="1"
                                 ItemsSource="{Binding Entries}"
                                 AutoGenerateColumns="False"
                                 CanUserInsertRows="True" NewRowPosition="Bottom"
                                 GroupRenderMode="Flat" ShowGroupPanel="False"
                                 SelectionUnit="Cell" GridLinesVisibility="Both"
                                 RowIndicatorVisibility="Collapsed"
                                 ClipboardCopyMode="Cells"
                                 PreviewKeyDown="Grid_PreviewKeyDown">
                <telerik:RadGridView.Columns>
                    <!-- 국명 : 초성 자동완성 -->
                    <telerik:GridViewDataColumn Header="일반명" Width="190" DataMemberBinding="{Binding SpeciesKo}">
                        <telerik:GridViewDataColumn.CellEditTemplate>
                            <DataTemplate>
                                <telerik:RadAutoCompleteBox SelectionMode="Single"
                                    WatermarkContent="초성 검색 (예: ㅊㄷㅇㄹ)"
                                    DisplayMemberPath="SpeciesKo"
                                    TextSearchPath="SpeciesKo"
                                    TextSearchMode="Contains"
                                    SelectedItem="{Binding SelectedSpecies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{Binding DataContext.SpeciesListSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <telerik:RadAutoCompleteBox.FilteringBehavior>
                                        <core:ChosungFilteringBehavior/>
                                    </telerik:RadAutoCompleteBox.FilteringBehavior>
                                </telerik:RadAutoCompleteBox>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellEditTemplate>
                    </telerik:GridViewDataColumn>

                    <!-- 개체수 : 국명 바로 옆 배치 (엑셀 [국명,개체수] 2열 붙여넣기 정렬) -->
                    <telerik:GridViewDataColumn Header="개체수" Width="80" DataMemberBinding="{Binding IndividualCount}"
                                                DataFormatString="{}{0:N0}" TextAlignment="Right"/>
                    <telerik:GridViewDataColumn Header="학명" Width="170" DataMemberBinding="{Binding SpeciesEn}"/>
                    <telerik:GridViewDataColumn Header="목" Width="90" DataMemberBinding="{Binding OrderKo}"/>
                    <telerik:GridViewDataColumn Header="과" Width="90" DataMemberBinding="{Binding FamilyKo}"/>
                    <telerik:GridViewComboBoxColumn Header="도래유형" Width="100"
                        DataMemberBinding="{Binding MigratoryType}"
                        ItemsSourceBinding="{Binding DataContext.MigratoryTypes, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"/>
                    <telerik:GridViewDataColumn Header="대항목" Width="100" DataMemberBinding="{Binding Category}"/>
                    <telerik:GridViewDataColumn Header="세부항목" Width="100" DataMemberBinding="{Binding CategoryDetail}"/>
                    <telerik:GridViewDataColumn Header="서식유형" Width="100" DataMemberBinding="{Binding HabitatType}"/>
                    <telerik:GridViewDataColumn Header="위도" Width="95" IsFilterable="False"
                                                DataMemberBinding="{Binding Lat}" DataFormatString="{}{0:N6}" TextAlignment="Right"/>
                    <telerik:GridViewDataColumn Header="경도" Width="95" IsFilterable="False"
                                                DataMemberBinding="{Binding Lng}" DataFormatString="{}{0:N6}" TextAlignment="Right"/>
                    <telerik:GridViewDataColumn Header="특징" Width="*" MinWidth="120" DataMemberBinding="{Binding Feature}"/>
                    <telerik:GridViewDataColumn Header="특이사항" Width="150" DataMemberBinding="{Binding Note}"/>
                    <telerik:GridViewDataColumn Header="구분" Width="140" IsReadOnly="True"
                                               DataMemberBinding="{Binding ProtectionText}"
                                               ToolTipService.ToolTip="공식 종목록의 법정보호종·생태계교란생물 표기(자동)"/>
                </telerik:RadGridView.Columns>

                <!-- 보호종 / 생태계교란생물 강조 (의미가 반대이므로 색을 구분한다) -->
                <telerik:RadGridView.RowStyle>
                    <Style TargetType="telerik:GridViewRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="ToolTip" Value="{Binding ProtectionText}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInvasive}" Value="True">
                                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="ToolTip" Value="{Binding ProtectionText}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </telerik:RadGridView.RowStyle>
            </telerik:RadGridView>
        </Grid>

        <!-- 하단 상태바 + 액션 -->
        <Border Grid.Row="2" Margin="2 8 2 2" Padding="8 6" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalSpeciesCount, StringFormat=총 {0}종}" FontWeight="SemiBold"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalIndividualCount, StringFormat= · {0}개체}" Margin="4 0 16 0"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <telerik:RadButton Command="{Binding PruneEmptyCommand}" Margin="0 0 8 0" Padding="10 4"
                                       ToolTipService.ToolTip="국명·개체수가 모두 빈 행을 제거합니다">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteSweepOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="빈 행 정리" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding AddRowCommand}" Margin="0 0 8 0" Padding="10 4">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="PlusBoxOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="행 추가" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding SaveTemporaryCommand}" Margin="0 0 8 0" Padding="10 4">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="임시 저장" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportBulkCommand}" Margin="0 0 8 0" Padding="10 4"
                                       ToolTipService.ToolTip="관리자 일괄입력용(레거시 양식) · 현행 관리자 Import 취합용">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="일괄입력용" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportExcelCommand}" Padding="10 4"
                                       ToolTipService.ToolTip="보고서·기록용 · 조사개황/출현종/출현종요약 시트">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="보고서 엑셀" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
