<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.BenthosEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:core="clr-namespace:SDSM_Surveyor_App.Behaviors"
             xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
             xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
             xmlns:m="clr-namespace:SDSM_Surveyor_App.Models"
             mc:Ignorable="d" d:DesignWidth="1224" d:DesignHeight="700"
             d:DataContext="{d:DesignInstance vm:BenthosEntryViewModel}">

    <!-- 저서동물 (종 입력형) — 어류와 같은 골격 (README §구현 순서 4)
         세로 : 조사환경 요약 36 → 건강성 요약 36 → 빠른추가 56 → 종 그리드 → 합계 36 → 상태바 48
         ⚠ 우측 결과 레일을 걷어내고 지수를 본문 상단으로 올렸다.
         ⚠ 지수(DI·H'·R1·J'·BMI)는 SDSM_Core/Ecology 가 계산한다 — 여기서는 결과만 그린다.
         ⚠ 조사환경 31칸은 저서동물 야장이 서식환경 실측(하폭·수폭·수심·유속·기온·수온)을 함께 지기 때문이다. -->

    <ctrl:FillPanel Margin="0 0 0 12">
        <!-- C-3 : 바탕은 Grid 가 아니라 FillPanel 이다(나온 순서대로 쌓는다 · Grid.Row 는 보지 않는다).
             채움 칸(FillPanel.Fill)만 남은 높이를 받고, 모자라면 최소 높이를 지킨 채 바깥 본문이 스크롤된다. -->

        <!--═══ ① 조사환경 (31칸) ═══════════════════════════════════════-->
        <ctrl:CollapsibleSummary Grid.Row="0" Title="조사환경"
                                 Caption="31개 항목 · 지점당 1회 입력하고 접어 두면 종 그리드가 넓어집니다"
                                 IsExpanded="{Binding IsEnvironmentExpanded, Mode=TwoWay}">
            <ctrl:CollapsibleSummary.SummarySlot>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="채집기" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding GearSummary}" Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Text="하천유형" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding HabitatRiverType, Converter={StaticResource EmptyToDot}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Text="하폭" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding RiverWidth, Converter={StaticResource EmptyToDot}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Text="평균수심" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding AverageDepth, Converter={StaticResource EmptyToDot}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Text="수온" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding WaterTemperature, Converter={StaticResource EmptyToDot}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Text="하상구성" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding SubstrateSummary}" Style="{StaticResource SummaryValueTextStyle}"/>

                    <!-- 하상구성 합계가 100 이 아니거나 정수가 아닌 값이 있으면 접힌 상태에서도 알린다(B-6 · 어류와 같게) -->
                    <TextBlock Text="{Binding EnvironmentWarning}" Margin="12 0 0 0"
                               Style="{StaticResource InlineWarnTextStyle}"/>
                </StackPanel>
            </ctrl:CollapsibleSummary.SummarySlot>

            <ctrl:CollapsibleSummary.ExpandedSlot>
                <!-- C-3 : 종전에는 높이 300 안에서 따로 스크롤했다(그리드를 남기려고). 이제 본문 전체가 스크롤되므로 다 펼쳐 보인다. -->
                    <StackPanel>
                        <!-- 채집방법 (정량 채집기) 4 — C-5 : 양식 14~17행은 도구마다 "해당될 경우 조사회수" 다.
                             칸 이름에 (회)를 붙여 횟수임이 보이게 하고, 쓰지 않은 도구는 비워 둔다(0 이 아니다 · 정수 제한은 B-6). -->
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                            <Border Style="{StaticResource GroupHeaderBarStyle}"/>
                            <TextBlock Text="채집방법 (정량 채집기)" Style="{StaticResource GroupHeaderTextStyle}"/>
                            <TextBlock Text="해당될 때만 조사 횟수 — 쓰지 않은 도구는 비워 둡니다" Margin="12 0 0 0"
                                       Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding GearWarning}" Margin="12 0 0 0"
                                       Style="{StaticResource InlineWarnTextStyle}"/>
                        </StackPanel>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="Surber 30×30 (회)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             WatermarkContent="횟수" ToolTipService.ToolTip="Surber net 30×30 cm — 조사 횟수(해당될 때만)"
                                                             core:IntegerInput.IsEnabled="True" Text="{Binding Surbernet30, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="Surber 50×50 (회)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             WatermarkContent="횟수" ToolTipService.ToolTip="Surber net 50×50 cm — 조사 횟수(해당될 때만)"
                                                             core:IntegerInput.IsEnabled="True" Text="{Binding Surbernet50, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="드렛지/D-Net (회)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             WatermarkContent="횟수" ToolTipService.ToolTip="드렛지 / D-Net — 조사 횟수(해당될 때만)"
                                                             core:IntegerInput.IsEnabled="True" Text="{Binding Dredge, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="에크만 (회)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             WatermarkContent="횟수" ToolTipService.ToolTip="에크만 그랩 — 조사 횟수(해당될 때만)"
                                                             core:IntegerInput.IsEnabled="True" Text="{Binding Ekman, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- 서식처 6 -->
                        <StackPanel Orientation="Horizontal" Margin="0 4 0 8">
                            <Border Style="{StaticResource GroupHeaderBarStyle}"/>
                            <TextBlock Text="서식처" Style="{StaticResource GroupHeaderTextStyle}"/>
                        </StackPanel>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FormFieldXlStyle}">
                                <TextBlock Text="유역이용" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" MinHeight="{StaticResource InputHeight}" TextWrapping="Wrap" VerticalContentAlignment="Center"
                                                             Text="{Binding Watershed, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldXlStyle}">
                                <TextBlock Text="확인 가능 오염원" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" MinHeight="{StaticResource InputHeight}" TextWrapping="Wrap" VerticalContentAlignment="Center"
                                                             Text="{Binding PollutionSource, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <!-- C-4 : 아래 선택 칸은 최종본 양식 정의 그대로(Models\FormChoices).
                                 식생 수피도만 코드 숫자(1·2·3)를 저장한다(관리자가 이름으로 바꾼다 · 10-16 정정). -->
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="식생 수피도" Style="{StaticResource FormLabelStyle}"/>
                                <ctrl:SingleChoiceBox Options="{x:Static m:FormChoices.CanopyCover}" Value="{Binding CanopyCover}"
                                                      ToolTipText="양식 20행 — 1 없음 / 2 부분적 / 3 짙음 중 택1 (코드 숫자로 저장)"
                                                      AutomationName="식생 수피도"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldMdStyle}">
                                <TextBlock Text="범람원의 이용" Style="{StaticResource FormLabelStyle}"/>
                                <ctrl:MultiChoiceBox Options="{x:Static m:FormChoices.Floodplain}" Value="{Binding Floodplain}"
                                                     ToolTipText="양식 21행 — 자연형 / 농경지 / 도로 / 주차장 / 산책로 / 기타 (여러 개)"
                                                     AutomationName="범람원의 이용"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldMdStyle}">
                                <TextBlock Text="제방(좌안)" Style="{StaticResource FormLabelStyle}"/>
                                <ctrl:MultiChoiceBox Options="{x:Static m:FormChoices.Levee}" Value="{Binding LeveeLeft}" AllowCustom="True"
                                                     ToolTipText="양식 22행 — 자연형 / 석축 / 돌망태 / 콘크리트, 그 밖은 아래 칸에 직접 입력 (여러 개)"
                                                     AutomationName="제방(좌안)"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldMdStyle}">
                                <TextBlock Text="제방(우안)" Style="{StaticResource FormLabelStyle}"/>
                                <ctrl:MultiChoiceBox Options="{x:Static m:FormChoices.Levee}" Value="{Binding LeveeRight}" AllowCustom="True"
                                                     ToolTipText="양식 23행 — 자연형 / 석축 / 돌망태 / 콘크리트, 그 밖은 아래 칸에 직접 입력 (여러 개)"
                                                     AutomationName="제방(우안)"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- 서식지 하상구성 (%) 8 — 어류와 같은 항목·같은 폭 -->
                        <StackPanel Orientation="Horizontal" Margin="0 4 0 8">
                            <Border Style="{StaticResource GroupHeaderBarStyle}"/>
                            <TextBlock Text="서식지 하상구성 (%) — 합계 100" Style="{StaticResource GroupHeaderTextStyle}"/>
                            <TextBlock Text="{Binding SubstrateWarning}" Margin="12 0 0 0"
                                       Style="{StaticResource InlineWarnTextStyle}"/>
                        </StackPanel>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FormFieldXsStyle}">
                                <TextBlock Text="암반" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                             core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Bedrock, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldXsStyle}">
                                <TextBlock Text="콘크리트" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                             core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Concrete, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="진흙(&lt;0.063mm)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                             core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Mud, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="모래(0.063-2mm)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                             core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Sand, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="잔자갈(2-16mm)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                             core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding FineGravel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="자갈(16-64mm)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                             core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding Gravel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="작은돌(64-256mm)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                             core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding SmallStone, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="큰돌(&gt;256mm)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}" WatermarkContent="%"
                                                             core:IntegerInput.IsEnabled="True" core:IntegerInput.Maximum="100" Text="{Binding BigStone, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- 서식처 (수리·환경) 10 + 특이사항 2 -->
                        <StackPanel Orientation="Horizontal" Margin="0 4 0 8">
                            <Border Style="{StaticResource GroupHeaderBarStyle}"/>
                            <TextBlock Text="서식처 (수리·환경) · 특이사항" Style="{StaticResource GroupHeaderTextStyle}"/>
                        </StackPanel>
                        <WrapPanel>
                            <!-- 양식 33행은 '하천유형(서식처)' 다(1 산간형, 2 평지형, 3 강, 4 인공구조물). 종전 화면 이름 '하천형태' 는 어류 항목 이름이었다.
                                 ⚠ 이름으로 저장한다 — 코드 1 을 쓰면 관리자 코드표 오타로 '산강형' 이 된다(§3-5). -->
                            <StackPanel Style="{StaticResource FormFieldMdStyle}">
                                <TextBlock Text="하천유형(서식처)" Style="{StaticResource FormLabelStyle}"/>
                                <ctrl:SingleChoiceBox Options="{x:Static m:FormChoices.HabitatRiverType}" Value="{Binding HabitatRiverType}"
                                                      ToolTipText="양식 33행 — 산간형 / 평지형 / 강 / 인공구조물 중 택1"
                                                      AutomationName="하천유형(서식처)"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldXsStyle}">
                                <TextBlock Text="하폭(m)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             Text="{Binding RiverWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldXsStyle}">
                                <TextBlock Text="수폭(m)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             Text="{Binding WaterWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldXsStyle}">
                                <TextBlock Text="평균수심(cm)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             Text="{Binding AverageDepth, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="평균유속(cm/s)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             Text="{Binding AverageVelocity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldXsStyle}">
                                <TextBlock Text="기온(℃)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             Text="{Binding AirTemperature, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldXsStyle}">
                                <TextBlock Text="수온(℃)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                                             Text="{Binding WaterTemperature, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldMdStyle}">
                                <TextBlock Text="흐름상태" Style="{StaticResource FormLabelStyle}"/>
                                <ctrl:MultiChoiceBox Options="{x:Static m:FormChoices.FlowState}" Value="{Binding FlowState}"
                                                     ToolTipText="양식 40행 — 여울 / 흐름 / 소 (여러 개)"
                                                     AutomationName="흐름상태"/>
                            </StackPanel>
                            <!-- 투명도·냄새 : 정수 1~5 를 글자로 저장한다(세션 형식 그대로) — 일괄입력용에는 숫자로 나간다(관리자 int?) -->
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="투명도" Style="{StaticResource FormLabelStyle}"/>
                                <ctrl:SingleChoiceBox Options="{x:Static m:FormChoices.Transparency}" Value="{Binding Transparency}"
                                                      ToolTipText="양식 41행 — 매우 맑음 1 ~ 5 매우 탁함"
                                                      AutomationName="투명도"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldSmStyle}">
                                <TextBlock Text="냄새" Style="{StaticResource FormLabelStyle}"/>
                                <ctrl:SingleChoiceBox Options="{x:Static m:FormChoices.Smell}" Value="{Binding Smell}"
                                                      ToolTipText="양식 42행 — 없음 1 ~ 5 매우 심함"
                                                      AutomationName="냄새"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldXlStyle}">
                                <TextBlock Text="채집불가시(사유)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" MinHeight="{StaticResource InputHeight}" TextWrapping="Wrap" VerticalContentAlignment="Center"
                                                             WatermarkContent="접근불가/건천화 등"
                                                             Text="{Binding SurveyUnavailableReason, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormFieldXlStyle}">
                                <TextBlock Text="특이사항(비고)" Style="{StaticResource FormLabelStyle}"/>
                                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" MinHeight="{StaticResource InputHeight}" TextWrapping="Wrap" VerticalContentAlignment="Center"
                                                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
            </ctrl:CollapsibleSummary.ExpandedSlot>
        </ctrl:CollapsibleSummary>

        <!--═══ ② 건강성 (종전 우측 결과 레일) ═══════════════════════════-->
        <ctrl:CollapsibleSummary Grid.Row="1" Margin="0 8 0 0" Title="건강성"
                                 Caption="{Binding HealthCaption}"
                                 IsExpanded="{Binding IsHealthExpanded, Mode=TwoWay}">
            <ctrl:CollapsibleSummary.SummarySlot>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BMI" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding BmiScore, TargetNullValue='-', StringFormat={}{0:N1}}"
                               VerticalAlignment="Center" Margin="0 0 8 0"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AccentOnSurfaceBrush}"/>
                    <Border Margin="0 0 12 0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GradeBadgeBorderStyle}">
                                <Setter Property="Height" Value="{StaticResource GradeBadgeSmallHeight}"/>
                                <Setter Property="MinWidth" Value="28"/>
                                <Setter Property="CornerRadius" Value="{StaticResource GradeBadgeSmallCornerRadius}"/>
                                <Setter Property="Padding" Value="9 0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BmiGrade}" Value="A">
                                        <Setter Property="Background" Value="{StaticResource GradeABrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding BmiGrade}" Value="B">
                                        <Setter Property="Background" Value="{StaticResource GradeBBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding BmiGrade}" Value="C">
                                        <Setter Property="Background" Value="{StaticResource GradeCBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding BmiGrade}" Value="D">
                                        <Setter Property="Background" Value="{StaticResource GradeDBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding BmiGrade}" Value="E">
                                        <Setter Property="Background" Value="{StaticResource GradeEBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BmiGrade, TargetNullValue='-'}" FontSize="13"
                                   Style="{StaticResource GradeBadgeTextStyle}"/>
                    </Border>

                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Text="다양도 H'" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding IndexH, TargetNullValue='·', StringFormat={}{0:N3}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>
                    <TextBlock Text="우점도 DI" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding IndexDI, TargetNullValue='·', StringFormat={}{0:N3}}"
                               Style="{StaticResource SummaryValueTextStyle}"/>

                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Style="{StaticResource SummaryValueTextStyle}">
                        <Run Text="총"/>
                        <Run Text="{Binding TotalSpeciesCount, Mode=OneWay}"/><Run Text="종 ·"/>
                        <Run Text="{Binding TotalIndividualCount, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text="개체"/>
                    </TextBlock>

                    <Border Style="{StaticResource VerticalDividerStyle}"/>
                    <TextBlock Text="보호종" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding ProtectedCount}" Margin="0 0 8 0" VerticalAlignment="Center"
                               FontSize="{StaticResource SummaryFontSize}" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentOnSurfaceBrush}"/>
                    <TextBlock Text="고유종" Style="{StaticResource SummaryLabelTextStyle}"/>
                    <TextBlock Text="{Binding EndemicCount}" Margin="0 0 12 0" VerticalAlignment="Center"
                               FontSize="{StaticResource SummaryFontSize}" FontWeight="SemiBold"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasMissingCounts, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource VerticalDividerStyle}"/>
                        <icon:PackIconMaterial Kind="AlertCircleOutline" Width="13" Height="13"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerOnSurfaceBrush}"/>
                        <TextBlock Text="{Binding MissingCountText}" Margin="4 0 0 0" VerticalAlignment="Center"
                                   FontSize="{StaticResource SummaryFontSize}"
                                   Foreground="{StaticResource DangerOnSurfaceBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ctrl:CollapsibleSummary.SummarySlot>

            <ctrl:CollapsibleSummary.ExpandedSlot>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Width="{StaticResource HealthLeftWidth}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BmiScore, TargetNullValue='-', StringFormat={}{0:N1}}"
                                       Style="{StaticResource ValueTextStyle}"/>
                            <Border Margin="12 0 0 0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GradeBadgeBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BmiGrade}" Value="A">
                                                <Setter Property="Background" Value="{StaticResource GradeABrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding BmiGrade}" Value="B">
                                                <Setter Property="Background" Value="{StaticResource GradeBBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding BmiGrade}" Value="C">
                                                <Setter Property="Background" Value="{StaticResource GradeCBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding BmiGrade}" Value="D">
                                                <Setter Property="Background" Value="{StaticResource GradeDBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding BmiGrade}" Value="E">
                                                <Setter Property="Background" Value="{StaticResource GradeEBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BmiGrade, TargetNullValue='-'}"
                                           Style="{StaticResource GradeBadgeTextStyle}"/>
                            </Border>
                            <TextBlock Text="저서동물 건강성" Margin="12 0 0 0" VerticalAlignment="Bottom"
                                       Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                        <TextBlock Margin="0 8 0 0" Style="{StaticResource CaptionTextStyle}"
                                   Text="BMI = (4 − Σ(s·g·h) / Σ(g·h)) × 25 · s 오탁치 · g 지표가중치 · h 순위점수"/>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource VerticalDividerStyle}"
                            Height="Auto" VerticalAlignment="Stretch" Margin="20 0"/>

                    <!-- 다양도 4지수 + 총계 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0 0 24 0">
                            <TextBlock Text="총 종수" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding TotalSpeciesCount}" Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 24 0">
                            <TextBlock Text="총 개체수" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding TotalIndividualCount, StringFormat={}{0:N0}}"
                                       Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                        <!-- H1 : 개체밀도 = 총 개체수 ÷ 채집 면적(Models\BenthosDensity 면적표) · 표시만 — 지수는 실측 개체수 -->
                        <StackPanel Margin="0 0 24 0" MaxWidth="240"
                                    AutomationProperties.AutomationId="BenthosDensityPanel">
                            <TextBlock Text="개체밀도(inds./㎡)" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding TotalDensityText}" Style="{StaticResource ValueTextStyle}"
                                       AutomationProperties.AutomationId="BenthosDensityValue"/>
                            <TextBlock Text="{Binding DensityBasis}" Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" AutomationProperties.AutomationId="BenthosDensityBasis"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 24 0">
                            <TextBlock Text="우점종" Style="{StaticResource CaptionTextStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DominantSpecies}"
                                           Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Margin="6 0 0 0" VerticalAlignment="Bottom"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding DominantShare, TargetNullValue='·', StringFormat={}{0:N1}%}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="우점도 DI" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding IndexDI, TargetNullValue='·', StringFormat={}{0:N3}}"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="다양도 H'" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding IndexH, TargetNullValue='·', StringFormat={}{0:N3}}"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="풍부도 R1" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding IndexR1, TargetNullValue='·', StringFormat={}{0:N3}}"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="균등도 J'" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Text="{Binding IndexJ, TargetNullValue='·', StringFormat={}{0:N3}}"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="3" Style="{StaticResource WarnBoxBorderStyle}" MaxWidth="280"
                            Visibility="{Binding HasMissingCounts, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="AlertCircleOutline" Width="14" Height="14"
                                                   VerticalAlignment="Top" Margin="0 2 6 0"
                                                   Foreground="{StaticResource DangerOnSurfaceBrush}"/>
                            <TextBlock Text="{Binding MissingCountDetail}" Style="{StaticResource WarnBoxTextStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ctrl:CollapsibleSummary.ExpandedSlot>
        </ctrl:CollapsibleSummary>

        <!--═══ ③ 빠른추가 ═══════════════════════════════════════════════-->
        <ctrl:QuickAddBar Grid.Row="2" Margin="0 8 0 0"
                          SearchWatermark="초성으로 종명 검색 (예: ㄲㅍㄹ)"
                          CountWatermark="개체수"
                          Hint="Enter 추가 후 검색창 복귀 · Ctrl+V 엑셀 다중 행 · F2 편집"/>

        <!--═══ ④ 종 그리드 + 합계 행 ═══════════════════════════════════
             선언 열 폭 : 40 + 220 + * + 96 + 96 + 96 + 96 + 200 = 고정폭 844px
             오탁치(s)·지표가중치(g)는 BMI 의 입력이라 화면에 근거로 함께 보인다. -->
        <!-- C-3 : 조사환경·건강성을 펼쳐도 그리드 8행 + 합계는 남긴다(모자라면 바깥 본문이 스크롤된다) -->
        <Grid Grid.Row="3" Margin="0 8 0 0" ctrl:FillPanel.Fill="True" MinHeight="{StaticResource SpeciesAreaMinHeight}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 10-17 : 비고(긴 글) 열 = 말줄임 + 툴팁 · 편집 때 아래에 전체 글(core:LongTextColumn) -->
            <telerik:RadGridView x:Name="SpeciesGrid" Grid.Row="0" core:LongTextColumn.Enable="True"
                                 ItemsSource="{Binding SpeciesEntries}"
                                 AutoGenerateColumns="False"
                                 CanUserInsertRows="True"
                                 NewRowPosition="Bottom"
                                 GroupRenderMode="Flat"
                                 ShowGroupPanel="False"
                                 IsSynchronizedWithCurrentItem="True"
                                 SelectionUnit="Cell"
                                 GridLinesVisibility="Horizontal"
                                 RowIndicatorVisibility="Collapsed"
                                 ClipboardCopyMode="Cells"
                                 CanUserFreezeColumns="False"
                                 IsFilteringAllowed="False"
                                 CanUserSortColumns="False"
                                 RowHeight="{StaticResource GridRowHeight}"
                                 AlternationCount="2"
                                 AlternateRowBackground="{StaticResource RowAltBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 PreviewKeyDown="Grid_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="Grid_PreviewMouseDown"
                                 PreviewMouseRightButtonDown="Grid_PreviewMouseDown">
                <telerik:RadGridView.ContextMenu>
                    <!-- PlacementTarget 을 거쳐 그리드의 DataContext(화면 VM)로 간다 —
                         ContextMenu 는 시각 트리 밖이라 DataContext 상속을 믿으면 안 된다. -->
                    <ContextMenu>
                        <MenuItem Header="이 행 삭제"
                                  Command="{Binding PlacementTarget.DataContext.DeleteRowCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </telerik:RadGridView.ContextMenu>
                <telerik:RadGridView.Columns>

                    <telerik:GridViewDataColumn Header="#" Width="40" IsReadOnly="True" IsFilterable="False"
                                                DataMemberBinding="{Binding RowNumber}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RowNumber}" Style="{StaticResource GridIndexTextStyle}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <telerik:GridViewDataColumn Header="국명" Width="220"
                                                DataMemberBinding="{Binding SpeciesKo}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SpeciesKo, Converter={StaticResource EmptyToDot}}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Style="{StaticResource ProtectedBadgeBorderStyle}"
                                            Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ProtectionBadgeText}"
                                                   Style="{StaticResource ProtectedBadgeTextStyle}"/>
                                    </Border>
                                    <Border Style="{StaticResource NeutralBadgeBorderStyle}"
                                            Visibility="{Binding IsEndemic, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="고유종" Style="{StaticResource NeutralBadgeTextStyle}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>

                        <telerik:GridViewDataColumn.CellEditTemplate>
                            <DataTemplate>
                                <telerik:RadAutoCompleteBox
                                    SelectionMode="Single" AutoCompleteMode="Suggest"
                                    WatermarkContent="초성으로 종명 검색"
                                    DisplayMemberPath="SpeciesKo"
                                    TextSearchPath="SpeciesKo"
                                    TextSearchMode="Contains"
                                    BorderBrush="{StaticResource InputBorderBrush}"
                                    BorderThickness="{StaticResource BorderThin}"
                                    Background="{StaticResource InputBackBrush}"
                                    SelectedItem="{Binding SelectedSpecies, Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{Binding DataContext.SpeciesListSource,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <telerik:RadAutoCompleteBox.FilteringBehavior>
                                        <core:ChosungFilteringBehavior/>
                                    </telerik:RadAutoCompleteBox.FilteringBehavior>
                                    <!-- D1(2026-10-18) : 똑같은 이름만 강조 — Enter 가 첫 후보로 바꾸지 않는다 -->
                                    <telerik:RadAutoCompleteBox.HighlightBehavior>
                                        <core:ExactNameHighlightBehavior/>
                                    </telerik:RadAutoCompleteBox.HighlightBehavior>
                                </telerik:RadAutoCompleteBox>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellEditTemplate>
                    </telerik:GridViewDataColumn>

                    <telerik:GridViewDataColumn Header="학명" Width="*" MinWidth="160"
                                                DataMemberBinding="{Binding SelectedSpecies.SpeciesEn}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SelectedSpecies.SpeciesEn, Converter={StaticResource EmptyToDot}}"
                                           Style="{StaticResource GridScientificNameTextStyle}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <telerik:GridViewDataColumn Header="개체수" Width="96" TextAlignment="Right"
                                                DataMemberBinding="{Binding IndividualCount}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IndividualCount, Converter={StaticResource EmptyToDot}}"
                                           ToolTipService.ToolTip="미입력(·)과 실측 0 은 다르게 저장됩니다">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridNumberTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding IndividualCount, Converter={StaticResource IsEmpty}}">
                                                    <Setter Property="Foreground"
                                                            Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <!-- BMI 입력값 : 종목록에서 자동 상속된다 -->
                    <telerik:GridViewDataColumn Header="오탁치 s" Width="96" IsReadOnly="True" TextAlignment="Right"
                                                DataMemberBinding="{Binding SaprobicText}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SaprobicText}" Style="{StaticResource GridNumberTextStyle}"
                                           ToolTipService.ToolTip="{Binding TraitTooltip}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <telerik:GridViewDataColumn Header="지표가중치 g" Width="96" IsReadOnly="True" TextAlignment="Right"
                                                DataMemberBinding="{Binding IndicatorWeightText}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IndicatorWeightText}" Style="{StaticResource GridNumberTextStyle}"
                                           ToolTipService.ToolTip="{Binding TraitTooltip}"/>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <telerik:GridViewDataColumn Header="상대풍부도" Width="96" IsReadOnly="True" TextAlignment="Right"
                                                DataMemberBinding="{Binding RelativeAbundance}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ReadOnlyBackBrush}" Margin="-6 -1">
                                    <TextBlock Margin="6 0" Style="{StaticResource GridNumberTextStyle}"
                                               Text="{Binding RelativeAbundance, TargetNullValue='·', StringFormat={}{0:N1}%}"/>
                                </Border>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                    <telerik:GridViewDataColumn Header="비고" Width="200" core:LongTextColumn.IsLongText="True"
                                                DataMemberBinding="{Binding Note}">
                        <telerik:GridViewDataColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Note, Converter={StaticResource EmptyToDot}}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding Note}"
                                               Style="{StaticResource GridInheritedTextStyle}"
                                               Visibility="{Binding IsJustAdded, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <TextBlock Text="방금 추가" VerticalAlignment="Center"
                                               FontSize="{StaticResource LinkFontSize}"
                                               Foreground="{StaticResource AccentOnSurfaceBrush}"
                                               Visibility="{Binding IsJustAdded, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </DataTemplate>
                        </telerik:GridViewDataColumn.CellTemplate>
                    </telerik:GridViewDataColumn>

                </telerik:RadGridView.Columns>

                <!-- 보호종 = 좌측 3px 강조바 + 국명 SemiBold + 뱃지 (색만으로 구분하지 않는다 · §11) -->
                <telerik:RadGridView.RowStyle>
                    <Style TargetType="telerik:GridViewRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AppAccentStrongBrush}"/>
                                <Setter Property="BorderThickness" Value="3 0 0 0"/>
                                <Setter Property="ToolTip" Value="법정보호종 — 멸종위기 야생생물"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsJustAdded}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                <Setter Property="ToolTip" Value="{Binding ErrorContent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </telerik:RadGridView.RowStyle>
            </telerik:RadGridView>

            <!-- 빈 상태 (README §11.4) -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Margin="0 40 0 0"
                        Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}">
                <icon:PackIconMaterial Kind="PlusBoxOutline" Width="28" Height="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TertiaryForegroundBrush}"/>
                <TextBlock Text="위 빠른추가로 종을 추가하세요" Margin="0 10 0 0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TertiaryForegroundBrush}"/>
                <TextBlock Text="초성으로 종명을 찾고 개체수를 넣은 뒤 Enter · 엑셀에서 Ctrl+V 로 여러 줄도 됩니다"
                           Margin="0 4 0 0" HorizontalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource TertiaryForegroundBrush}"/>
            </StackPanel>

            <!-- 합계 행 : 열 폭을 그리드와 같게 두어 개체수·상대풍부도 아래에 합이 온다 -->
            <Border Grid.Row="1" Style="{StaticResource GridTotalRowBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Margin="8 0 0 0" Style="{StaticResource GridTotalTextStyle}"
                               Text="{Binding TotalSpeciesCount, StringFormat=합계 {0}종}"/>
                    <TextBlock Grid.Column="3" Margin="0 0 8 0" HorizontalAlignment="Right"
                               Style="{StaticResource GridTotalTextStyle}"
                               Text="{Binding TotalIndividualCount, StringFormat={}{0:N0}}"/>
                    <TextBlock Grid.Column="6" Margin="0 0 8 0" HorizontalAlignment="Right"
                               Style="{StaticResource GridTotalTextStyle}"
                               Text="{Binding TotalShareText}"/>
                    <Border Grid.Column="8" Width="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
                </Grid>
            </Border>
        </Grid>

        <!--═══ ⑤ 상태 · 액션 바 ═══════════════════════════════════════-->
        <ctrl:TaxonStatusBar Grid.Row="4" Margin="0 8 0 0" WarningText="{Binding WarningText}">
            <ctrl:TaxonStatusBar.Summary>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalSpeciesCount, StringFormat=총 {0}종}" FontWeight="SemiBold"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalIndividualCount, StringFormat= · {0:N0}개체}" Margin="4 0 0 0"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                </StackPanel>
            </ctrl:TaxonStatusBar.Summary>
            <ctrl:TaxonStatusBar.Actions>
                <StackPanel Orientation="Horizontal">
                    <!-- 종전에는 결과 레일에 있던 항목이다. 레일을 걷어냈으므로 상태바로 옮긴다.
                         조사는 했으나 한 종도 확인되지 않은 지점을 명시적으로 선언한다(12_CALC_FIX §2-1) —
                         목록이 비었다는 사실만으로는 "아직 미입력"과 구분되지 않는다. -->
                    <telerik:RadToggleButton IsChecked="{Binding NoSpeciesDeclared, Mode=TwoWay}"
                                             Margin="{StaticResource ActionButtonMargin}"
                                             Padding="{StaticResource ActionButtonPadding}"
                                             ToolTipService.ToolTip="조사는 수행했으나 한 종도 확인되지 않은 경우 선택합니다. 점수 0 · 등급 E 로 산정됩니다. 조사불가 사유가 있으면 그쪽이 우선합니다.">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="CheckboxBlankOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="출현종 없음(0종)" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadToggleButton>
                    <telerik:RadButton Command="{Binding PruneEmptyCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       Foreground="{StaticResource DangerActionForeBrush}"
                                       ToolTipService.ToolTip="국명·개체수가 모두 빈 행을 제거합니다">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteSweepOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="빈 행 정리" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding SaveTemporaryCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="임시 저장" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportBulkCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       ToolTipService.ToolTip="관리자 일괄입력용 · 현행 관리자 Import 취합용">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
