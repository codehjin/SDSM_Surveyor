<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.AmphibianReptileEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:core="clr-namespace:SDSM_Surveyor_App.Behaviors"
             xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
             xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
             xmlns:models="clr-namespace:SDSM_Surveyor_App.Models"
             mc:Ignorable="d" d:DesignWidth="1224" d:DesignHeight="540"
             d:DataContext="{d:DesignInstance vm:AmphibianReptileEntryViewModel}">

    <!-- ══ 관찰형 — 양서파충류 17열 (06_DESIGN_REBUILD §5-2-2 · §5-2-4) ═══════════
         17열을 하나도 줄이지 않는다(§3-6).

         ⚠ **묶음을 내리는 것만으로는 안 들어간다** (복제 시 폭 합계로 확인) :
             현재 1행 고정폭 합            1,618
             흔적 6칸을 2행으로            -418
             1행에 붙는 관찰계(읽기전용)     +66
             → 1,266  … 허용 1,104 를 **162 초과**
           그래서 식별 열 폭까지 규격화한다 → 1행 고정 1,080 + 특징 144 = 1,224.

           1행 : 일반명 156 · 학명 138 · 목 72 · 과 72 · 대분류 80 · 중분류 88
                 · 관찰계 60 · 위도 88 · 경도 88 · 특징 * · 특이사항 132 · 구분 106
           2행 : 성체 · 유생 · 알 · 울음소리 · 로드킬 · 기타  (6칸 · 상시 표시)

         ⚠ 식별 열이 포유류·조류보다 약간 좁다(일반명 156 vs 168). 17열을 다 담기 위한 대가다.
         ══════════════════════════════════════════════════════════════════════════ -->
    <ctrl:FillPanel Margin="8">
        <!-- C-3 : 바탕은 Grid 가 아니라 FillPanel 이다(나온 순서대로 쌓는다 · Grid.Row 는 보지 않는다).
             채움 칸(FillPanel.Fill)만 남은 높이를 받고, 모자라면 최소 높이를 지킨 채 바깥 본문이 스크롤된다. -->

        <!--═══ 요약 스트립 (36px) ═══════════════════════════════════════
             관찰형은 결과 레일을 두지 않는다(design.md §5.2) — 레일을 두면 그리드가
             300px 좁아져 2단 행의 1행 열이 안 들어간다. 대신 한 줄 요약을 위에 둔다.
             ⚠ 보호종과 교란종은 의미가 반대라 색과 숫자를 분리해 적는다(§11). -->
        <Border Grid.Row="0" Style="{StaticResource SummaryRowBorderStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="양서파충류" Style="{StaticResource GroupHeaderTextStyle}"/>
                <Border Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>

                <TextBlock Style="{StaticResource SummaryValueTextStyle}">
                    <Run Text="총"/>
                    <Run Text="{Binding TotalSpeciesCount, Mode=OneWay}"/><Run Text="종 ·"/>
                    <Run Text="{Binding TotalIndividualCount, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text="개체"/>
                </TextBlock>

                <Border Style="{StaticResource VerticalDividerStyle}"/>
                <TextBlock Text="보호종" Style="{StaticResource SummaryLabelTextStyle}"/>
                <TextBlock Text="{Binding ProtectedCount}" Margin="0 0 8 0" VerticalAlignment="Center"
                           FontSize="{StaticResource SummaryFontSize}" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentOnSurfaceBrush}"/>
                <TextBlock Text="교란종" Style="{StaticResource SummaryLabelTextStyle}"/>
                <TextBlock Text="{Binding InvasiveCount}" VerticalAlignment="Center"
                           FontSize="{StaticResource SummaryFontSize}" FontWeight="SemiBold"
                           Foreground="{StaticResource DangerTextBrush}"/>

                <!-- N3 : 분류군 조사일(비면 조사개황 조사일) — 좁은 요약줄이라 안내는 툴팁으로 -->
                <Border Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>
                <ctrl:TaxonDateBar ShowHint="False"/>
            </StackPanel>
        </Border>

        <ctrl:QuickAddBar Grid.Row="1" Margin="0 8 0 8"
                          SearchWatermark="종명 초성 검색 (예: ㅊㄱㄱㄹ)"
                          CountWatermark="성체 개체수"
                          Hint="개체수는 '성체' 칸에 들어갑니다 · 나머지 관찰은 아랫줄에서 입력 · 엑셀 Ctrl+V 가능"/>

        <!-- 채움 칸 : 관찰 그리드 + 빈 상태 안내(겹쳐 놓는다) -->
        <Grid ctrl:FillPanel.Fill="True">
        <ctrl:ObservationGrid Grid.Row="2" Rows="{Binding Entries}">
            <!-- ── 1행 12열 · 고정 합 1,080 + 특징 144 = 1,224 ───────────────────── -->
            <telerik:GridViewDataColumn Header="일반명" Width="156" DataMemberBinding="{Binding SpeciesKo}">
                <telerik:GridViewDataColumn.CellTemplate>
                    <DataTemplate>
                        <!-- 같은 종이 다른 행에도 있으면 '같은 종 n행'(B-1 · 관찰형은 합치지 않고 알리기만 한다)
                             공식 종목록에 없는 국명이면 '목록 밖'(B-4 · 국명은 그대로 저장한다) -->
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SameSpeciesBadgeBorderStyle}">
                                <TextBlock Text="{Binding SameSpeciesText}" Style="{StaticResource CheckBadgeTextStyle}"/>
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource UnlistedBadgeBorderStyle}">
                                <TextBlock Text="목록 밖" Style="{StaticResource CheckBadgeTextStyle}"/>
                            </Border>
                            <TextBlock Text="{Binding SpeciesKo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </telerik:GridViewDataColumn.CellTemplate>

                <telerik:GridViewDataColumn.CellEditTemplate>
                    <DataTemplate>
                        <telerik:RadAutoCompleteBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" SelectionMode="Single" AutoCompleteMode="Suggest"
                            WatermarkContent="초성 검색 (예: ㅊㄱㄱㄹ)"
                            DisplayMemberPath="SpeciesKo" TextSearchPath="SpeciesKo" TextSearchMode="Contains"
                            SelectedItem="{Binding SelectedSpecies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding DataContext.SpeciesListSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <telerik:RadAutoCompleteBox.FilteringBehavior>
                                <core:ChosungFilteringBehavior/>
                            </telerik:RadAutoCompleteBox.FilteringBehavior>
                            <!-- D1(2026-10-18) : 똑같은 이름만 강조 — Enter 가 첫 후보로 바꾸지 않는다 -->
                            <telerik:RadAutoCompleteBox.HighlightBehavior>
                                <core:ExactNameHighlightBehavior/>
                            </telerik:RadAutoCompleteBox.HighlightBehavior>
                        </telerik:RadAutoCompleteBox>
                    </DataTemplate>
                </telerik:GridViewDataColumn.CellEditTemplate>
            </telerik:GridViewDataColumn>

            <telerik:GridViewDataColumn Header="학명" Width="138" DataMemberBinding="{Binding SpeciesEn}"
                                        IsReadOnlyBinding="{Binding IsScientificNameLocked}"
                                        ToolTipService.ToolTip="종목록에 있는 국명은 학명이 종목록대로 들어갑니다(고칠 수 없음) · 목록 밖 국명만 직접 입력(D2)"/>
            <telerik:GridViewDataColumn Header="목" Width="72" DataMemberBinding="{Binding OrderKo}"/>
            <telerik:GridViewDataColumn Header="과" Width="72" DataMemberBinding="{Binding FamilyKo}"/>
            <!-- D6(2026-10-18) : 서식지 유형(양식 Y·Z열). 대분류 농림지역/산림지역/습지대/기타 지역 · 중분류는 대분류별 항목 여러 개(`, `로 잇는다).
                 대분류를 바꾸면 맞지 않는 중분류는 비운다. 양식에 없는 예전 값(양서류 등)은 지우지 않고 칸에 '양식 외'를 띄운다.
                 열 폭은 1280 화면에서 다른 열이 눌리지 않게 종전(80·88) 가까이 — 긴 중분류는 마우스를 올리면 전체가 보인다. -->
            <telerik:GridViewDataColumn Header="대분류" Width="80" DataMemberBinding="{Binding MajorCategory}"
                                        ToolTipService.ToolTip="서식지 유형 대분류 — 농림지역 / 산림지역 / 습지대 / 기타 지역(양식 Y열)">
                <telerik:GridViewDataColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTipService.ToolTip="{Binding HabitatOutOfForm}">
                            <TextBlock Text="{Binding MajorCategory}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HabitatOutOfForm}" Margin="4 0 0 0" Style="{StaticResource InlineWarnTextStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </telerik:GridViewDataColumn.CellTemplate>
                <telerik:GridViewDataColumn.CellEditTemplate>
                    <DataTemplate>
                        <ctrl:SingleChoiceBox Options="{x:Static models:FormChoices.AmphHabitatMajor}" Value="{Binding MajorCategory, Mode=TwoWay}"
                                              ShowWarning="False" AutomationName="서식지 대분류"/>
                    </DataTemplate>
                </telerik:GridViewDataColumn.CellEditTemplate>
            </telerik:GridViewDataColumn>
            <telerik:GridViewDataColumn Header="중분류" Width="96" DataMemberBinding="{Binding MiddleCategory}" core:LongTextColumn.IsLongText="True"
                                        ToolTipService.ToolTip="서식지 유형 중분류 — 대분류별 항목 여러 개(양식 Z열 · 예 묵논_경작지, 수로)">
                <telerik:GridViewDataColumn.CellEditTemplate>
                    <DataTemplate>
                        <ctrl:MultiChoiceBox Options="{Binding MiddleOptions}" Value="{Binding MiddleCategory, Mode=TwoWay}"
                                             Separator=", " ShowWarning="False" EmptyText="대분류를 먼저 고르세요" AutomationName="서식지 중분류"/>
                    </DataTemplate>
                </telerik:GridViewDataColumn.CellEditTemplate>
            </telerik:GridViewDataColumn>

            <!-- 관찰계 : 입력 항목이 아니라 피드백(§3-4). 2행을 보지 않아도 관찰 유무를 안다. -->
            <telerik:GridViewDataColumn Header="관찰계" Width="60" IsReadOnly="True" IsFilterable="False"
                                        TextAlignment="Right" DataMemberBinding="{Binding TraceSum}"
                                        ToolTipService.ToolTip="성체·유생·알·울음소리·로드킬·기타 6칸의 합계(자동)"/>

            <telerik:GridViewDataColumn Header="위도" Width="88" IsFilterable="False"
                                        DataMemberBinding="{Binding Lat}" DataFormatString="{}{0:N6}" TextAlignment="Right"/>
            <telerik:GridViewDataColumn Header="경도" Width="88" IsFilterable="False"
                                        DataMemberBinding="{Binding Lng}" DataFormatString="{}{0:N6}" TextAlignment="Right"/>
            <telerik:GridViewDataColumn Header="특징" Width="*" MinWidth="120" DataMemberBinding="{Binding Feature}" core:LongTextColumn.IsLongText="True"/>
            <telerik:GridViewDataColumn Header="특이사항" Width="132" DataMemberBinding="{Binding Note}" core:LongTextColumn.IsLongText="True"/>
            <telerik:GridViewDataColumn Header="구분" Width="106" IsReadOnly="True"
                                        DataMemberBinding="{Binding ProtectionText}"
                                        ToolTipService.ToolTip="공식 종목록의 법정보호종·생태계교란생물 표기(자동)"/>

            <!-- ── 2행 : 관찰 6칸 (상시 표시) ───────────────────────────────────────
                 6칸이라 여유가 있다 → 억지로 12등분하지 않고 넓게 쓰고 좌측 정렬한다.
                 미입력은 워터마크 `·`, 실측 0 은 `0` — null 과 0 을 눈으로 구분한다. -->
            <ctrl:ObservationGrid.RowDetails>
                <DataTemplate>
                    <Border Background="{StaticResource Row2LineBrush}" Height="{StaticResource GridRow2LineHeight}">
                        <StackPanel Style="{StaticResource RowDetailsPanelStyle}">
                            <TextBlock Text="╰▸ 관찰" Width="66" Style="{StaticResource RowDetailsTagStyle}"/>

                            <TextBlock Text="성체" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="유생" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="알" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="울음소리" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="로드킬" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="기타" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Width="72" WatermarkContent="·"
                                                         Text="{Binding Trace6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ctrl:ObservationGrid.RowDetails>
        </ctrl:ObservationGrid>

        <!-- ③ 상태 · 액션 바 -->
        <!-- 빈 상태 (README §11.4) -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False" Margin="0 40 0 0"
                    Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}">
            <icon:PackIconMaterial Kind="PlusBoxOutline" Width="28" Height="28"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TertiaryForegroundBrush}"/>
            <TextBlock Text="위 빠른추가로 종을 추가하세요" Margin="0 10 0 0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TertiaryForegroundBrush}"/>
            <TextBlock Text="초성으로 종명을 찾고 수량을 넣은 뒤 Enter · 엑셀에서 Ctrl+V 로 여러 줄도 됩니다"
                       Margin="0 4 0 0" HorizontalAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{StaticResource TertiaryForegroundBrush}"/>
        </StackPanel>

        </Grid>

        <ctrl:TaxonStatusBar Grid.Row="3" Margin="0 8 0 0">
            <ctrl:TaxonStatusBar.Summary>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalSpeciesCount, StringFormat=총 {0}종}" FontWeight="SemiBold"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalIndividualCount, StringFormat= · {0}개체}" Margin="4 0 0 0"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalObservations, StringFormat= · 관찰 {0}건}" Margin="4 0 0 0"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <!-- 문제 6 : 행 좌표가 비면(위도·경도 둘 다) 조사개황 지점 좌표로 채워 내보낸다 -->
                    <TextBlock Text="· 행 좌표가 비면 지점 좌표로 내보냄" Margin="12 0 0 0" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="RowCoordHint"
                               ToolTipService.ToolTip="위도·경도를 둘 다 비운 행은 조사개황 지점 좌표(위도·경도)로 채워 일괄입력용·보고서 엑셀에 냅니다. 관리자 자료에는 행 좌표만 들어갑니다."/>
                </StackPanel>
            </ctrl:TaxonStatusBar.Summary>
            <ctrl:TaxonStatusBar.Actions>
                <StackPanel Orientation="Horizontal">
                    <telerik:RadButton Command="{Binding PruneEmptyCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       Foreground="{StaticResource DangerActionForeBrush}"
                                       ToolTipService.ToolTip="국명·관찰이 모두 빈 행을 제거합니다">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteSweepOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="빈 행 정리" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding AddRowCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="PlusBoxOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="행 추가" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding SaveTemporaryCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="임시 저장" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportBulkCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       ToolTipService.ToolTip="관리자 일괄입력용(레거시 양식) · 현행 관리자 Import 취합용">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="일괄입력용" Margin="4 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <Button Command="{Binding ExportExcelCommand}" Padding="{StaticResource ActionButtonPadding}"
                                       Style="{StaticResource PrimaryActionButtonStyle}"
                                       ToolTipService.ToolTip="보고서·기록용 · 조사개황/출현종/출현종요약 시트">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="보고서 엑셀" Margin="4 0 0 0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ctrl:TaxonStatusBar.Actions>
        </ctrl:TaxonStatusBar>
    </ctrl:FillPanel>
</UserControl>
