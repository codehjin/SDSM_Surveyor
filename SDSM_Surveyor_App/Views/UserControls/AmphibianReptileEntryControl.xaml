<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.AmphibianReptileEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:core="clr-namespace:SDSM_Surveyor_App.Behaviors"
             xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
             xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1224" d:DesignHeight="540"
             d:DataContext="{d:DesignInstance vm:AmphibianReptileEntryViewModel}">

    <!-- ══ 관찰형 — 양서파충류 17열 (06_DESIGN_REBUILD §5-2-2 · §5-2-4) ═══════════
         17열을 하나도 줄이지 않는다(§3-6).

         ⚠ **묶음을 내리는 것만으로는 안 들어간다** (복제 시 폭 합계로 확인) :
             현재 1행 고정폭 합            1,618
             흔적 6칸을 2행으로            -418
             1행에 붙는 관찰계(읽기전용)     +66
             → 1,266  … 허용 1,104 를 **162 초과**
           그래서 식별 열 폭까지 규격화한다 → 1행 고정 1,080 + 특징 144 = 1,224.

           1행 : 일반명 156 · 학명 138 · 목 72 · 과 72 · 대분류 80 · 중분류 88
                 · 관찰계 60 · 위도 88 · 경도 88 · 특징 * · 특이사항 132 · 구분 106
           2행 : 성체 · 유생 · 알 · 울음소리 · 로드킬 · 기타  (6칸 · 상시 표시)

         ⚠ 식별 열이 포유류·조류보다 약간 좁다(일반명 156 vs 168). 17열을 다 담기 위한 대가다.
         ══════════════════════════════════════════════════════════════════════════ -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- ① 빠른 추가 -->
            <RowDefinition Height="*"/>     <!-- ② 관찰 그리드(2단 행) -->
            <RowDefinition Height="Auto"/>  <!-- ③ 상태 · 액션 -->
        </Grid.RowDefinitions>

        <ctrl:QuickAddBar Grid.Row="0" Margin="0 0 0 8"
                          SearchWatermark="종명 초성 검색 (예: ㅊㄱㄱㄹ)"
                          CountWatermark="성체 개체수"
                          Hint="개체수는 '성체' 칸에 들어갑니다 · 나머지 관찰은 아랫줄에서 입력 · 엑셀 Ctrl+V 가능"/>

        <ctrl:ObservationGrid Grid.Row="1" Rows="{Binding Entries}">
            <!-- ── 1행 12열 · 고정 합 1,080 + 특징 144 = 1,224 ───────────────────── -->
            <telerik:GridViewDataColumn Header="일반명" Width="156" DataMemberBinding="{Binding SpeciesKo}">
                <telerik:GridViewDataColumn.CellEditTemplate>
                    <DataTemplate>
                        <telerik:RadAutoCompleteBox SelectionMode="Single"
                            WatermarkContent="초성 검색 (예: ㅊㄱㄱㄹ)"
                            DisplayMemberPath="SpeciesKo" TextSearchPath="SpeciesKo" TextSearchMode="Contains"
                            SelectedItem="{Binding SelectedSpecies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding DataContext.SpeciesListSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <telerik:RadAutoCompleteBox.FilteringBehavior>
                                <core:ChosungFilteringBehavior/>
                            </telerik:RadAutoCompleteBox.FilteringBehavior>
                        </telerik:RadAutoCompleteBox>
                    </DataTemplate>
                </telerik:GridViewDataColumn.CellEditTemplate>
            </telerik:GridViewDataColumn>

            <telerik:GridViewDataColumn Header="학명" Width="138" DataMemberBinding="{Binding SpeciesEn}"/>
            <telerik:GridViewDataColumn Header="목" Width="72" DataMemberBinding="{Binding OrderKo}"/>
            <telerik:GridViewDataColumn Header="과" Width="72" DataMemberBinding="{Binding FamilyKo}"/>
            <telerik:GridViewComboBoxColumn Header="대분류" Width="80"
                DataMemberBinding="{Binding MajorCategory}"
                ItemsSourceBinding="{Binding DataContext.MajorCategories, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"/>
            <telerik:GridViewDataColumn Header="중분류" Width="88" DataMemberBinding="{Binding MiddleCategory}"/>

            <!-- 관찰계 : 입력 항목이 아니라 피드백(§3-4). 2행을 보지 않아도 관찰 유무를 안다. -->
            <telerik:GridViewDataColumn Header="관찰계" Width="60" IsReadOnly="True" IsFilterable="False"
                                        TextAlignment="Right" DataMemberBinding="{Binding TraceSum}"
                                        ToolTipService.ToolTip="성체·유생·알·울음소리·로드킬·기타 6칸의 합계(자동)"/>

            <telerik:GridViewDataColumn Header="위도" Width="88" IsFilterable="False"
                                        DataMemberBinding="{Binding Lat}" DataFormatString="{}{0:N6}" TextAlignment="Right"/>
            <telerik:GridViewDataColumn Header="경도" Width="88" IsFilterable="False"
                                        DataMemberBinding="{Binding Lng}" DataFormatString="{}{0:N6}" TextAlignment="Right"/>
            <telerik:GridViewDataColumn Header="특징" Width="*" MinWidth="120" DataMemberBinding="{Binding Feature}"/>
            <telerik:GridViewDataColumn Header="특이사항" Width="132" DataMemberBinding="{Binding Note}"/>
            <telerik:GridViewDataColumn Header="구분" Width="106" IsReadOnly="True"
                                        DataMemberBinding="{Binding ProtectionText}"
                                        ToolTipService.ToolTip="공식 종목록의 법정보호종·생태계교란생물 표기(자동)"/>

            <!-- ── 2행 : 관찰 6칸 (상시 표시) ───────────────────────────────────────
                 6칸이라 여유가 있다 → 억지로 12등분하지 않고 넓게 쓰고 좌측 정렬한다.
                 미입력은 워터마크 `·`, 실측 0 은 `0` — null 과 0 을 눈으로 구분한다. -->
            <ctrl:ObservationGrid.RowDetails>
                <DataTemplate>
                    <Border Background="{StaticResource Row2LineBrush}" Height="{StaticResource GridRow2LineHeight}">
                        <StackPanel Style="{StaticResource RowDetailsPanelStyle}">
                            <TextBlock Text="╰▸ 관찰" Width="66" Style="{StaticResource RowDetailsTagStyle}"/>

                            <TextBlock Text="성체" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="유생" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="알" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="울음소리" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="로드킬" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox Width="72" Margin="0 0 20 0" WatermarkContent="·"
                                                         Text="{Binding Trace5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                            <TextBlock Text="기타" Style="{StaticResource RowDetailsLabelStyle}"/>
                            <telerik:RadWatermarkTextBox Width="72" WatermarkContent="·"
                                                         Text="{Binding Trace6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ctrl:ObservationGrid.RowDetails>
        </ctrl:ObservationGrid>

        <!-- ③ 상태 · 액션 바 -->
        <ctrl:TaxonStatusBar Grid.Row="2" Margin="0 8 0 0">
            <ctrl:TaxonStatusBar.Summary>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalSpeciesCount, StringFormat=총 {0}종}" FontWeight="SemiBold"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalIndividualCount, StringFormat= · {0}개체}" Margin="4 0 0 0"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalObservations, StringFormat= · 관찰 {0}건}" Margin="4 0 0 0"
                               Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                </StackPanel>
            </ctrl:TaxonStatusBar.Summary>
            <ctrl:TaxonStatusBar.Actions>
                <StackPanel Orientation="Horizontal">
                    <telerik:RadButton Command="{Binding PruneEmptyCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       Foreground="{StaticResource DangerActionForeBrush}"
                                       ToolTipService.ToolTip="국명·관찰이 모두 빈 행을 제거합니다">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="DeleteSweepOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="빈 행 정리" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding AddRowCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="PlusBoxOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="행 추가" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding SaveTemporaryCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="임시 저장" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportBulkCommand}"
                                       Margin="{StaticResource ActionButtonMargin}" Padding="{StaticResource ActionButtonPadding}"
                                       ToolTipService.ToolTip="관리자 일괄입력용(레거시 양식) · 현행 관리자 Import 취합용">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="일괄입력용" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportExcelCommand}" Padding="{StaticResource ActionButtonPadding}"
                                       Background="{StaticResource PrimaryActionBackBrush}"
                                       Foreground="{StaticResource PrimaryActionForeBrush}"
                                       ToolTipService.ToolTip="보고서·기록용 · 조사개황/출현종/출현종요약 시트">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="보고서 엑셀" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>
            </ctrl:TaxonStatusBar.Actions>
        </ctrl:TaxonStatusBar>
    </Grid>
</UserControl>
