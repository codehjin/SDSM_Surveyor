<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.WaterQualityEntryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ctrl="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
             xmlns:vm="clr-namespace:SDSM_Surveyor_App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="740"
             d:DataContext="{d:DesignInstance vm:WaterQualityEntryViewModel}">

    <UserControl.Resources>
        <!-- 공용 폼 라벨 스타일 상속 (design.md §4) -->
        <Style x:Key="WqCaption" TargetType="TextBlock" BasedOn="{StaticResource FormLabelStyle}"/>
        <!-- 항목 타일 : 라벨 · 입력 · (등급) 을 한 칸에 -->
        <Style x:Key="WqTile" TargetType="StackPanel">
            <Setter Property="Margin" Value="0 0 16 12"/>
        </Style>
        <Style x:Key="WqGrade" TargetType="TextBlock">
            <Setter Property="Margin" Value="0 3 0 0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- ① 조사개황(접이식) -->
            <RowDefinition Height="*"/>     <!-- ② 측정항목 · 추가항목 -->
            <RowDefinition Height="Auto"/>  <!-- 하단 상태바/액션 -->
        </Grid.RowDefinitions>

        <!-- ① 조사개황 -->
        <Border Grid.Row="0" Margin="2" Padding="14"
                Background="{telerik:Windows11Resource ResourceKey=SecondaryBackgroundBrush}"
                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                BorderThickness="1"
                CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="조사개황" Style="{StaticResource SubHeaderTextStyle}" Margin="0"/>
                        <TextBlock Text="지점당 1회 입력 후 접어두면 측정값 입력이 편해집니다" Margin="10 0 0 0"
                                   VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                    <telerik:RadToggleButton Grid.Column="1" x:Name="MetaToggle" IsChecked="True" Padding="12 4"
                                             Content="접기 / 펼치기"/>
                </Grid>

                <StackPanel Margin="0 10 0 0"
                            Visibility="{Binding IsChecked, ElementName=MetaToggle, Converter={StaticResource BoolToVisibility}}">
                    <ctrl:SurveyOverviewControl DataContext="{Binding Meta}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ② 측정 항목 + 추가 항목 -->
        <ScrollViewer Grid.Row="1" Margin="2 8 2 2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 측정 항목 : 등급 8종은 자동 산정(입력 대상 아님) -->
                <Border Padding="14" Margin="0 0 0 10"
                        Background="{telerik:Windows11Resource ResourceKey=SecondaryBackgroundBrush}"
                        BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                        BorderThickness="1" CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}">
                    <StackPanel>
                        <TextBlock Text="측정 항목" FontWeight="SemiBold" Margin="0 0 0 2"
                                   Foreground="{StaticResource AppAccentStrongBrush}"/>
                        <TextBlock Text="입력 즉시 등급이 자동 산정됩니다 (등급은 조사자가 입력하지 않습니다)"
                                   Margin="0 0 0 10" Style="{StaticResource CaptionTextStyle}"/>

                        <UniformGrid Columns="3">
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="pH" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding PH, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource WqGrade}" Text="{Binding PhGradeText, StringFormat=등급  {0}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="BOD (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Bod, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource WqGrade}" Text="{Binding BodGradeText, StringFormat=등급  {0}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="COD (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Cod, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource WqGrade}" Text="{Binding CodGradeText, StringFormat=등급  {0}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="TOC (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Toc, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource WqGrade}" Text="{Binding TocGradeText, StringFormat=등급  {0}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="SS (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Ss, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource WqGrade}" Text="{Binding SsGradeText, StringFormat=등급  {0}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="DO (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Dox, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource WqGrade}" Text="{Binding DoGradeText, StringFormat=등급  {0}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="T-P (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Tp, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource WqGrade}" Text="{Binding TpGradeText, StringFormat=등급  {0}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="대장균군 (군수/100mL)" Style="{StaticResource WqCaption}" TextWrapping="Wrap"/>
                                <telerik:RadWatermarkTextBox Text="{Binding EColi, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource WqGrade}" Text="{Binding EColiGradeText, StringFormat=등급  {0}}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="생태독성 (TU)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Ecotoxicity, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="등급 없음" Margin="0 3 0 0" Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 추가 항목 : 등급 산정 대상이 아닌 확장 측정값 -->
                <Border Padding="14"
                        Background="{telerik:Windows11Resource ResourceKey=SecondaryBackgroundBrush}"
                        BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                        BorderThickness="1" CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}">
                    <StackPanel>
                        <TextBlock Text="추가 항목" FontWeight="SemiBold" Margin="0 0 0 2"
                                   Foreground="{StaticResource AppAccentStrongBrush}"/>
                        <TextBlock Text="등급 산정 대상이 아닌 확장 측정값입니다 (측정한 항목만 입력)"
                                   Margin="0 0 0 10" Style="{StaticResource CaptionTextStyle}"/>

                        <UniformGrid Columns="4">
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="T-N (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding TN, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="전기전도도 (µS/cm)" Style="{StaticResource WqCaption}" TextWrapping="Wrap"/>
                                <telerik:RadWatermarkTextBox Text="{Binding EC, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="염소이온 (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Cl, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="황이온 (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding SO42, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="구리 Cu (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Cu, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="아연 Zn (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Zn, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="크롬 Cr (mg/L)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Cr, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="탁도 (NTU)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Turbidity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="클로로필a (mg/m³)" Style="{StaticResource WqCaption}" TextWrapping="Wrap"/>
                                <telerik:RadWatermarkTextBox Text="{Binding Chla, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="수온 (℃)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding WaterTemperature, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="수심 (cm)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding WaterDepth, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="유속 (cm/s)" Style="{StaticResource WqCaption}"/>
                                <telerik:RadWatermarkTextBox Text="{Binding FlowVelocity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="초당유량 (m³/sec)" Style="{StaticResource WqCaption}" TextWrapping="Wrap"/>
                                <telerik:RadWatermarkTextBox Text="{Binding FlowSec, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource WqTile}">
                                <TextBlock Text="일당유량 (m³/day)" Style="{StaticResource WqCaption}" TextWrapping="Wrap"/>
                                <telerik:RadWatermarkTextBox Text="{Binding FlowDay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 하단 상태바 + 액션 -->
        <Border Grid.Row="2" Margin="2 8 2 2" Padding="8 6"
                Background="{telerik:Windows11Resource ResourceKey=SecondaryBackgroundBrush}"
                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                BorderThickness="1" CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <icon:PackIconMaterial Kind="ClockOutline" Width="14" Height="14" VerticalAlignment="Center"
                                           Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                    <TextBlock Text="{Binding StatusText}" Margin="6 0 0 0"
                               Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <telerik:RadButton Command="{Binding SaveTemporaryCommand}" Margin="0 0 8 0" Padding="10 4">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconMaterial Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="임시 저장" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportBulkCommand}" Margin="0 0 8 0" Padding="10 4"
                                       ToolTipService.ToolTip="관리자 일괄입력용(레거시 양식) · 현행 관리자 Import 취합용">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="일괄입력용" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding ExportExcelCommand}" Padding="10 4"
                                       ToolTipService.ToolTip="보고서·기록용 · 조사개황/측정결과/건강성평가(수질등급) 시트">
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="보고서 엑셀" Margin="6 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
