<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.SurveyOverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:models="clr-namespace:SDSM_Surveyor_App.Models"
             xmlns:data="clr-namespace:SDSM_Surveyor_App.Data"
             xmlns:uc="clr-namespace:SDSM_Surveyor_App.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance models:SurveyMeta}">

    <!-- 공통 조사개황 : **셸이 한 번만** 소유한다(06_DESIGN_REBUILD §5-1-4).
         종전에는 7개 분류군 컨트롤이 이 컨트롤을 각자 끼워 껍데기가 7벌이었다.
         SurveyMeta 는 싱글턴이라 내용은 원래 하나였다.
         ⚠ §3-8 대분류 격리 UI(지점 잠금·해제·목록 분리)가 이제 이 한 곳에만 존재한다.
            x:Name·AutomationId·바인딩 이름을 바꾸지 말 것(격리 검증 26건이 SiteCombo 를 찾는다). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 1행 : 언제·어디서 ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FormFieldStyle}">
            <uc:PinnedFieldLabel Text="대분류" Pin="{Binding Pins.Project}"/>
            <telerik:RadComboBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{Binding Pins.Project.IsOn, Converter={StaticResource PinnedBack}}" Height="{StaticResource InputHeight}"
                                 ItemsSource="{Binding Projects}" SelectedItem="{Binding Project, Mode=TwoWay}"
                                 EmptyText="방류하천/생태현황"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FormFieldStyle}">
            <TextBlock Text="연도" Style="{StaticResource FormLabelStyle}"/>
            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                         WatermarkContent="2024" Text="{Binding SurveyYear, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FormFieldStyle}">
            <uc:PinnedFieldLabel Text="연도차수" Pin="{Binding Pins.YearChsu}"/>
            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{Binding Pins.YearChsu.IsOn, Converter={StaticResource PinnedBack}}" Height="{StaticResource InputHeight}"
                                         WatermarkContent="2024반기1차" Text="{Binding YearChsu, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="3" Style="{StaticResource FormFieldStyle}">
            <uc:PinnedFieldLabel Text="조사일자" Pin="{Binding Pins.SurveyDate}"/>
            <telerik:RadDatePicker BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{Binding Pins.SurveyDate.IsOn, Converter={StaticResource PinnedBack}}" Height="{StaticResource InputHeight}" SelectedValue="{Binding SurveyDate, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="4" Style="{StaticResource FormFieldStyle}">
            <uc:PinnedFieldLabel Text="날씨" Pin="{Binding Pins.Weather}"/>
            <telerik:RadComboBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{Binding Pins.Weather.IsOn, Converter={StaticResource PinnedBack}}" Height="{StaticResource InputHeight}"
                                 ItemsSource="{Binding Weathers}" SelectedItem="{Binding Weather, Mode=TwoWay}"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="5" Style="{StaticResource FormFieldStyle}">
            <uc:PinnedFieldLabel Text="조사자" Pin="{Binding Pins.Surveyor}"/>
            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{Binding Pins.Surveyor.IsOn, Converter={StaticResource PinnedBack}}" Height="{StaticResource InputHeight}"
                                         Text="{Binding Surveyor, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- ── 2행 : 지점 (2칸 차지 — 안내 문구가 아래에 붙는다) ──────────────── -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FormFieldStyle}">
            <TextBlock Text="지점명" Style="{StaticResource FormLabelStyle}"/>
            <!-- 등록된 지점만 선택. ST번호(ST1·St.1·st 1)를 쳐도 DB상 지점명으로 정규화한다.
                 C-7 : 항목은 하천 → 하천별 혼합 규칙으로 정렬되고(SiteOrdering), St.번호는 믿을 수 있는 하천만 붙는다.
                       St.번호에 맞는 지점이 여럿이면 자동으로 고르지 않고 그 후보만 펼쳐 보인다(아래 안내 문구에 후보 이름).
                 E2(2026-10-18 (2)) : Enter·Tab = 같은 이름 → 방향키·마우스로 고른 후보 → 그 밖은 고르지 않음(코드비하인드 Decide).
                       치는 동안·포커스가 떠날 때 콤보가 맞는 첫 항목을 골라 버리지 않게
                       CanAutocompleteSelectItems=False · UpdateSelectionOnLostFocus=False.
                 G1(2026-10-18 (3)) : ↓ = 친 글자로 거른 후보(같음 → 앞부분 → 포함)를 펼쳐 그 안에서 움직임(코드비하인드 MoveCandidate).
                       콤보 자체 거르기(IsFilteringEnabled)는 끈다 — 후보를 바꿔 끼울 때 콤보가 다시 거르지 않게.
                 ⚠ 대분류를 고르기 전에는 잠긴다 — 방류하천과 생태현황에 같은 이름의 다른 지점이 있어
                    섞어 보여주면 자료가 조용히 섞인다(_ecostatus_sites_extracted §8-2). -->
            <telerik:RadComboBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" x:Name="SiteCombo" AutomationProperties.AutomationId="SiteCombo"
                                 Height="{StaticResource InputHeight}"
                                 ItemsSource="{Binding SiteChoices}"
                                 SelectedItem="{Binding SelectedSiteChoice, Mode=TwoWay}"
                                 DisplayMemberPath="Display"
                                 IsEnabled="{Binding IsSiteSelectable}"
                                 IsEditable="True" IsFilteringEnabled="False" IsTextSearchEnabled="False"
                                 CanAutocompleteSelectItems="False" UpdateSelectionOnLostFocus="False"
                                 EmptyText="지점 선택 또는 ST번호 입력"
                                 LostFocus="SiteCombo_LostFocus"
                                 PreviewKeyDown="SiteCombo_PreviewKeyDown"
                                 PreviewTextInput="SiteCombo_PreviewTextInput"
                                 DropDownClosed="SiteCombo_DropDownClosed"
                                 PreviewMouseLeftButtonDown="SiteCombo_PreviewMouseLeftButtonDown"
                                 KeyDown="SiteCombo_KeyDown"/>
            <TextBlock Text="{Binding SiteHint}" Style="{StaticResource CaptionTextStyle}"
                       Margin="0 4 0 0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="미등록 지점입니다 — 목록에서 선택하세요"
                       Style="{StaticResource CaptionTextStyle}" Margin="0 4 0 0"
                       Foreground="{StaticResource MaxBrush}"
                       Visibility="{Binding IsSiteUnregisteredWarning, Converter={StaticResource BoolToVisibility}}"/>
            <!-- D4 ②(2026-10-18) : 생태현황은 목록에 없는 지점을 직접 입력한다(지점명이 없으면 하천명만으로도 저장).
                 방류하천은 지금처럼 목록에서만 고른다(위 빨간 경고). -->
            <TextBlock Text="목록 밖 지점 — 하천명·좌표·대권역·중권역을 직접 적으세요"
                       AutomationProperties.AutomationId="OffListSiteText"
                       Style="{StaticResource CaptionTextStyle}" Margin="0 4 0 0"
                       Foreground="{StaticResource AppAccentDarkBrush}" TextWrapping="Wrap"
                       Visibility="{Binding IsOffListSite, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource FormFieldStyle}">
            <TextBlock Text="하천명" Style="{StaticResource FormLabelStyle}"/>
            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                         WatermarkContent="지점 선택 시 자동 · 목록 밖 지점은 직접"
                                         Text="{Binding River, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="3" Style="{StaticResource FormFieldStyle}">
            <TextBlock Text="사업장" Style="{StaticResource FormLabelStyle}"/>
            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                         WatermarkContent="지점 선택 시 자동"
                                         Text="{Binding Workplace, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- 좌표 2칸 + 지도 버튼 -->
        <Grid Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Margin="{StaticResource FieldMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0 0 8 0">
                <TextBlock Text="위도" Style="{StaticResource FormLabelStyle}"/>
                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                             WatermarkContent="37.xxxxxx" Text="{Binding Lat, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0 0 8 0">
                <TextBlock Text="경도" Style="{StaticResource FormLabelStyle}"/>
                <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                             WatermarkContent="127.xxxxxx" Text="{Binding Lng, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Width="58">
                <TextBlock Text=" " Style="{StaticResource FormLabelStyle}"/>
                <!-- ⚠ HasMap 으로 잠그지 않는다. 잠그면 좌표를 넣기 전에는 지도를 추가할 길이 없어진다
                     (지도 관리로 가는 입구가 이 버튼뿐이다). 좌표가 없으면 마커만 안 찍는다. -->
                <telerik:RadButton Content="지도" Height="{StaticResource InputHeight}"
                                   Click="Map_Click"
                                   ToolTip="등록된 지도를 보고 지도를 추가·교체합니다"/>
            </StackPanel>
        </Grid>

        <!-- ── 3행 : 행정·기관 ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FormFieldStyle}">
            <!-- C-6 : 지점을 고르면 하천 단위 고정표(Data\RegionTable)로 채운다. 고칠 수 있고, 지점을 다시 고르면 다시 채운다. -->
            <TextBlock Text="대권역명" Style="{StaticResource FormLabelStyle}"/>
            <!-- D4 ② : 표에 없는 하천(생태현황 목록 밖 지점 등)은 목록에서 고르거나 직접 적는다(편집 가능 콤보) -->
            <telerik:RadComboBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                 AutomationProperties.AutomationId="MajorRegionCombo"
                                 IsEditable="True" EmptyText="지점 선택 시 자동 · 직접 고름"
                                 ItemsSource="{x:Static data:RegionTable.Majors}"
                                 Text="{Binding MajorRegion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FormFieldStyle}">
            <TextBlock Text="중권역명" Style="{StaticResource FormLabelStyle}"/>
            <telerik:RadComboBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{StaticResource InputBackBrush}" Height="{StaticResource InputHeight}"
                                 AutomationProperties.AutomationId="MiddleRegionCombo"
                                 IsEditable="True" EmptyText="지점 선택 시 자동 · 직접 고름"
                                 ItemsSource="{x:Static data:RegionTable.Middles}"
                                 Text="{Binding MiddleRegion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource FormFieldStyle}"
                    Visibility="{Binding IsRiverTypeVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="하천유형" Style="{StaticResource FormLabelStyle}"/>
            <!-- C-4 : 양식 8행 '산간형/평지형/강' 택1 · 이름 저장. 예전 값(평지천 등)은 지우지 않고 '(양식 외)' 경고 -->
            <!-- D7(2026-10-18) : 선택지는 지금 분류군 양식대로(어류·저서 산간형/평지형/강 · 수질·서식수변 본류/지류/기타).
                 조류·포유류·양서파충류 양식에는 하천유형이 없어 칸을 숨긴다(값은 지우지 않는다). -->
            <!-- E1(2026-10-18 (2)) : 칸을 둘로 — 어류·저서 RiverType(산간형/평지형/강) · 수질·서식수변 RiverTypeWater(본류/지류/기타).
                 보고 있는 분류군 탭에 맞는 칸 하나만 보이고, 탭을 바꿔도 값은 두 칸 모두 그대로다. -->
            <uc:SingleChoiceBox Options="{x:Static models:FormChoices.RiverType}" Value="{Binding RiverType}"
                                Visibility="{Binding IsRiverTypeFishVisible, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.AutomationId="RiverTypeFishBox"
                                ToolTipText="{Binding RiverTypeHint}" AutomationName="하천유형"/>
            <uc:SingleChoiceBox Options="{x:Static models:FormChoices.RiverTypeWater}" Value="{Binding RiverTypeWater}"
                                Visibility="{Binding IsRiverTypeWaterVisible, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.AutomationId="RiverTypeWaterBox"
                                ToolTipText="{Binding RiverTypeHint}" AutomationName="하천유형"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource FormFieldStyle}">
            <uc:PinnedFieldLabel Text="조사기관" Pin="{Binding Pins.SurveyAgency}"/>
            <telerik:RadWatermarkTextBox BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="{StaticResource BorderThin}" Background="{Binding Pins.SurveyAgency.IsOn, Converter={StaticResource PinnedBack}}" Height="{StaticResource InputHeight}"
                                         Text="{Binding SurveyAgency, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- 고정 해제 : 3행 마지막 칸(비어 있던 자리). 고정이 하나도 없으면 눌리지 않는다. -->
        <StackPanel Grid.Row="2" Grid.Column="5" Style="{StaticResource FormFieldStyle}">
            <TextBlock Text=" " Style="{StaticResource FormLabelStyle}"/>
            <Button Content="고정 모두 해제" Height="{StaticResource InputHeight}"
                    Style="{StaticResource SmallOutlineButtonStyle}"
                    Command="{Binding Pins.ClearAllCommand}"
                    IsEnabled="{Binding Pins.HasPins}"
                    ToolTipService.ToolTip="켜 둔 압정을 모두 끕니다. 저장된 값은 지우지 않습니다."/>
        </StackPanel>
    </Grid>
</UserControl>
