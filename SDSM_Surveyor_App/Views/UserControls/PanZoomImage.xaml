<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.PanZoomImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root" ClipToBounds="True">

    <!-- 지도 이미지 + 마커. 휠로 확대/축소, 끌어서 이동.
         ⚠ Canvas 를 쓴다. Grid·StackPanel 은 자식 크기를 늘리거나 가운데로 옮겨
            픽셀 대응이 깨진다.
         ⚠ TransformGroup 순서(Scale → Translate)를 바꾸지 말 것.
            화면좌표 = 이미지픽셀 * zoom + pan 이 이 순서에서만 성립한다.
         ⚠ Image 의 Width/Height 는 코드가 **픽셀 수**로 직접 넣는다.
            안 그러면 DPI 가 96 이 아닌 지도에서 마커가 어긋난다(ImageSize 주석 참조). -->
    <Border x:Name="Viewport" Background="{StaticResource PageBackBrush}" ClipToBounds="True"
            MouseWheel="Viewport_MouseWheel"
            MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
            MouseMove="Viewport_MouseMove"
            MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
            SizeChanged="Viewport_SizeChanged">

        <Canvas x:Name="Stage" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" RenderTransformOrigin="0,0">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="Pan" X="0" Y="0"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <Image x:Name="MapImage" Canvas.Left="0" Canvas.Top="0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- 현재 입력 좌표 마커 : 딱 하나만 그린다.
                 지도에 이미 인쇄된 지점 표시는 배경 그대로 둔다(앱이 덧그리지 않는다). -->
            <Ellipse x:Name="MarkerDot" Width="16" Height="16" Visibility="Collapsed"
                     Fill="{StaticResource MarkerFillBrush}"
                     Stroke="{StaticResource MarkerStrokeBrush}" StrokeThickness="2"/>

            <Border x:Name="MarkerLabel" Visibility="Collapsed"
                    Style="{StaticResource MapMarkerLabelStyle}">
                <TextBlock x:Name="MarkerText" Style="{StaticResource MapMarkerTextStyle}"/>
            </Border>

            <!-- 2점 보정용 기준점 -->
            <Ellipse x:Name="PickA" Width="14" Height="14" Visibility="Collapsed"
                     Fill="{StaticResource AppAccentBrush}"
                     Stroke="{StaticResource MarkerStrokeBrush}" StrokeThickness="2"/>
            <Ellipse x:Name="PickB" Width="14" Height="14" Visibility="Collapsed"
                     Fill="{StaticResource AppAccentStrongBrush}"
                     Stroke="{StaticResource MarkerStrokeBrush}" StrokeThickness="2"/>
        </Canvas>
    </Border>
</UserControl>
