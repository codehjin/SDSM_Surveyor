<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.TaxonStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" d:DesignWidth="1200"
             x:Name="Root">

    <!-- 하단 상태 · 액션 바 (06_DESIGN_REBUILD §5-2-0 · §5-3)
         7개 화면이 같은 바를 쓴다. 좌측 총계와 우측 버튼만 화면마다 다르므로 슬롯으로 받는다.

         버튼 계층(§5-3) : 위험(빈 행 정리)은 **가장 왼쪽**, 주요(보고서 엑셀)는 가장 오른쪽.
         멀리 떼어 놓아야 잘못 누르지 않는다. -->
    <Border Style="{StaticResource StatusBarBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 화면별 총계 슬롯 (총 12종 · 341개체 …) -->
                <ContentPresenter Content="{Binding Summary, ElementName=Root}" VerticalAlignment="Center"/>

                <icon:PackIconMaterial Kind="ClockOutline" Width="14" Height="14" Margin="16 0 0 0"
                                       VerticalAlignment="Center"
                                       Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                <TextBlock Text="{Binding StatusText}" Margin="6 0 0 0"
                           Style="{StaticResource RailLabelStyle}"/>

                <!-- 이상치 경고 : 붉은 글자 + 아이콘 병행(색만으로 구분하지 않는다 · design.md §10).
                     ⚠ 비차단이다 — 저장·내보내기를 막지 않는다(§3-5). -->
                <StackPanel Orientation="Horizontal" Margin="14 0 0 0" VerticalAlignment="Center"
                            Visibility="{Binding HasWarning, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                    <icon:PackIconMaterial Kind="AlertCircleOutline" Width="14" Height="14"
                                           VerticalAlignment="Center"
                                           Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                    <TextBlock Text="{Binding WarningText, ElementName=Root}" Margin="6 0 0 0"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- 화면별 액션 슬롯 -->
            <ContentPresenter Grid.Column="1" Content="{Binding Actions, ElementName=Root}"
                              VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
