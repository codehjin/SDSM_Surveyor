<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.CollapsibleSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" d:DesignWidth="1224"
             x:Name="Root">

    <!-- 접힘 요약줄 + 펼친 카드 (README §2.4·§2.5·§3 · 신규 공용 컨트롤)
         7개 분류군이 공유한다 — 조사환경·건강성·측정항목 등 '한 번 적고 접어 두는' 블록 전부.

         접으면 36px 한 줄이 되고 종 그리드가 12행 → 20행이 된다.
         ⚠ 접힘은 **숨기기가 아니다.** 요약줄이 값을 계속 보여 줘야 조사자가
           접어 둔 채로도 무엇이 들어갔는지 확인할 수 있다.

         ⚠ 높이 애니메이션은 넣지 않았다. Auto 높이를 매 프레임 재측정하면
           연속 입력 중 레이아웃이 흔들린다(design.md §2.9 — 애니메이션은 곧 대기 시간이다).
           대신 펼친 카드에 180ms ease-out 페이드만 준다. -->

    <Grid>
        <!--── 접힘 : 36px 한 줄 ────────────────────────────────────────────-->
        <Border Style="{StaticResource SummaryRowBorderStyle}"
                Visibility="{Binding IsExpanded, ElementName=Root,
                             Converter={StaticResource InverseBoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               Style="{StaticResource GroupHeaderTextStyle}"/>
                    <Border Style="{StaticResource VerticalDividerStyle}" Margin="12 0 12 0"/>
                </StackPanel>

                <!-- 화면이 넘기는 한 줄 요약(라벨·값 쌍) -->
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                  Content="{Binding SummarySlot, ElementName=Root}"/>

                <Button Grid.Column="2" Click="Toggle_Click"
                        Style="{StaticResource LinkButtonStyle}"
                        AutomationProperties.Name="{Binding Title, ElementName=Root, StringFormat={}{0} 펼치기}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="펼치기" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource ChevronPathStyle}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--── 펼침 : 카드 ─────────────────────────────────────────────────-->
        <Border Visibility="{Binding IsExpanded, ElementName=Root,
                             Converter={StaticResource BoolToVisibility}}">
            <!-- 펼칠 때마다 180ms ease-out 페이드(design.md §2.9).
                 ⚠ EventTrigger(Loaded)는 첫 표시에만 걸린다 — Visibility 토글에는 다시 걸리지 않는다.
                    그래서 IsExpanded 를 보는 DataTrigger 의 EnterActions 로 건다. -->
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <Grid Margin="0 0 0 12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Title, ElementName=Root}"
                               Style="{StaticResource SectionTitleTextStyle}"/>

                    <TextBlock Grid.Column="1" Text="{Binding Caption, ElementName=Root}"
                               Margin="12 0 8 0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource CaptionTextStyle}"/>

                    <Button Grid.Column="2" Click="Toggle_Click"
                            Style="{StaticResource LinkButtonStyle}"
                            AutomationProperties.Name="{Binding Title, ElementName=Root, StringFormat={}{0} 접기}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="접기" VerticalAlignment="Center"/>
                            <Path>
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource ChevronPathStyle}">
                                        <Setter Property="RenderTransformOrigin" Value="0.5 0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </StackPanel>
                    </Button>
                </Grid>

                <ContentPresenter Content="{Binding ExpandedSlot, ElementName=Root}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
