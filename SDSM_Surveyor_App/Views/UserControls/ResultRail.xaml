<UserControl x:Class="SDSM_Surveyor_App.Views.UserControls.ResultRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320"
             x:Name="Root">

    <!-- 결과 레일 (06_DESIGN_REBUILD §5-1-3)
         결과가 '값'인 유형에만 둔다 — 종 입력형(FAI·BMI)과 폼형(등급 요약·HRI).
         관찰형은 두지 않는다: 그리드가 300px 좁아지면 포유류 22열이 안 들어간다.

         ⚠ 폭은 320 고정이 아니다. 호스트가 MinWidth 280 / MaxWidth 360 의 * 열에 넣는다(§5-2-1). -->
    <Border Style="{StaticResource RailBorderStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding Header, ElementName=Root}"
                           Style="{StaticResource SubHeaderTextStyle}"/>
                <ContentPresenter Content="{Binding Body, ElementName=Root}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
