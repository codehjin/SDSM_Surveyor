<Application x:Class="SDSM_Surveyor_App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 순서 주의: Colors → Styles (Styles가 셸 브러시를 참조) -->
                <ResourceDictionary Source="pack://application:,,,/SDSM_Surveyor_App;component/Styles/Colors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SDSM_Surveyor_App;component/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
