# 빌드 산출물
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo

# 로컬 설정·데이터
*.db-shm
*.db-wal

# 대용량 참고자료
*.xlsx
!docs/**/*.xlsx
# 일괄입력용 양식 내장본(B-7) — 배포에 들어가므로 커밋한다
!SDSM_Surveyor_App/templates/**/*.xlsx

# python 도구 캐시
__pycache__/
*.pyc

# 게시 임시 폴더(단독 실행형이라 250MB+)
tools/_publish_test/
tools/_publish_release/
tools/_publish_zip/

# local leftovers
tools/_build.log
_to_delete/
docs/_backup_*/
docs/_maps_seed_old/
# 화면 확인용 사진(하네스가 찍음 · 커밋하지 않음)
docs/_screens_*/

# Telerik upgrade wizard
*_Backup_20*/
*_Report_20*.htm
